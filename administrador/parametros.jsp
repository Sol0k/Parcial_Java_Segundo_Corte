<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:update dataSource="${db}">INSERT IGNORE INTO parametro(clave,valor) VALUES ('creditos_minimos','75'),('max_prorrogas','2'),('dias_prorroga','180'),('pagina_proyectos','20'),('min_longitud_clave','8'),('min_porcentaje_materias','75'),('max_integrantes_estandar','2'),('max_integrantes_interdisciplinario','4'),('max_integrantes_pesado','3'),('min_longitud_texto_idea','30'),('min_seguimientos_director','2'),('revision_propuesta_dias_habiles','3'),('revision_informe_dias_habiles','5'),('fc125_min_dias','90'),('fc125_max_dias','180'),('practica_plazo_dias','365'),('dominio_correo_estudiante','@uts.edu.co')</sql:update><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE parametro SET valor=? WHERE clave=?<sql:param value="${param.valor}"/><sql:param value="${param.clave}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT clave,valor,CASE clave WHEN 'creditos_minimos' THEN 'Porcentaje mínimo de créditos aprobados' WHEN 'max_prorrogas' THEN 'Máximo de prórrogas por proyecto' WHEN 'dias_prorroga' THEN 'Duración de cada prórroga en días' WHEN 'pagina_proyectos' THEN 'Proyectos mostrados por página' WHEN 'min_longitud_clave' THEN 'Longitud mínima de contraseñas' WHEN 'min_porcentaje_materias' THEN 'Porcentaje mínimo de materias aprobadas' WHEN 'max_integrantes_estandar' THEN 'Máximo de integrantes estándar' WHEN 'max_integrantes_interdisciplinario' THEN 'Máximo de integrantes interdisciplinarios' WHEN 'max_integrantes_pesado' THEN 'Máximo de integrantes para modalidad pesada' WHEN 'min_longitud_texto_idea' THEN 'Caracteres mínimos de una idea' WHEN 'min_seguimientos_director' THEN 'Seguimientos mínimos del director' WHEN 'revision_propuesta_dias_habiles' THEN 'Días hábiles para revisar propuesta' WHEN 'revision_informe_dias_habiles' THEN 'Días hábiles para revisar informe final' WHEN 'fc125_min_dias' THEN 'Días mínimos del informe final' WHEN 'fc125_max_dias' THEN 'Días máximos del informe final' WHEN 'practica_plazo_dias' THEN 'Plazo de práctica en días' WHEN 'dominio_correo_estudiante' THEN 'Dominio institucional permitido' ELSE 'Parámetro institucional' END descripcion FROM parametro WHERE clave NOT LIKE 'festivo_%' AND clave NOT LIKE 'empresa_%' AND clave NOT LIKE 'requisitos_%' ORDER BY clave</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Parámetros · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><a class="back-link" href="../dashboard.jsp">← Panel principal</a><b>UTS · Administración</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ADMINISTRACIÓN</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="usuarios.jsp">Usuarios</a><a href="docentes.jsp">Docentes</a><a href="roles.jsp">Roles</a><a class="active" href="parametros.jsp">Parámetros</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">CONFIGURACIÓN</p><h1>Parámetros del sistema</h1><p>El administrador puede actualizar los valores que utiliza el flujo académico.</p><table><tr><th>Parámetro</th><th>Descripción</th><th>Valor</th><th>Acción</th></tr><c:forEach var="r" items="${rows.rows}"><tr><td><code>${r.clave}</code></td><td>${r.descripcion}</td><td><form method="post" class="inline-form"><input type="hidden" name="clave" value="${r.clave}"><input name="valor" value="${r.valor}" required></form></td><td><form method="post"><input type="hidden" name="clave" value="${r.clave}"><input type="hidden" name="valor" value="${r.valor}"><button>Guardar</button></form></td></tr></c:forEach></table></section></main></body></html>