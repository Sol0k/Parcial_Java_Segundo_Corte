<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT u.documento,u.nombre,u.correo,d.tipo,d.carga_maxima FROM docente d JOIN usuario u ON u.id=d.usuario_id ORDER BY u.nombre</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Docentes · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><a class="back-link" href="../dashboard.jsp">← Panel principal</a><b>UTS · Administración</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ADMINISTRACIÓN</div><a href="dashboard.jsp">Resumen</a><a href="usuarios.jsp">Usuarios</a><a class="active" href="docentes.jsp">Docentes</a><a href="roles.jsp">Roles</a><a href="parametros.jsp">Parámetros</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">CUERPO DOCENTE</p><h1>Docentes</h1><table><tr><th>Documento</th><th>Nombre</th><th>Correo</th><th>Tipo</th><th>Carga máxima</th></tr><c:forEach var="d" items="${rows.rows}"><tr><td>${d.documento}</td><td>${d.nombre}</td><td>${d.correo}</td><td>${d.tipo}</td><td>${d.carga_maxima}</td></tr></c:forEach></table></section></main></body></html>