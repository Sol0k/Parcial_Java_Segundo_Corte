<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT entidad,entidad_id,accion,observaciones,creado_en FROM historial ORDER BY id DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Historial · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><a class="back-link" href="../dashboard.jsp">← Panel principal</a><b>UTS · Administración</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ADMINISTRACIÓN</div><a href="dashboard.jsp">Resumen</a><a href="usuarios.jsp">Usuarios</a><a href="docentes.jsp">Docentes</a><a href="roles.jsp">Roles</a><a href="parametros.jsp">Parámetros</a><a class="active" href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">AUDITORÍA</p><h1>Historial administrativo</h1><table><tr><th>Entidad</th><th>ID</th><th>Acción</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="h" items="${rows.rows}"><tr><td>${h.entidad}</td><td>${h.entidad_id}</td><td>${h.accion}</td><td>${h.observaciones}</td><td>${h.creado_en}</td></tr></c:forEach></table></section></main></body></html>