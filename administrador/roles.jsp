<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Roles · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><a class="back-link" href="../dashboard.jsp">← Panel principal</a><b>UTS · Administración</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ADMINISTRACIÓN</div><a href="dashboard.jsp">Resumen</a><a href="usuarios.jsp">Usuarios</a><a href="docentes.jsp">Docentes</a><a class="active" href="roles.jsp">Roles</a><a href="parametros.jsp">Parámetros</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">PERMISOS</p><h1>Roles del sistema</h1><div class="cards"><article><h2>Estudiante</h2><p>Gestiona sus propuestas, documentos, pagos, prórrogas y PQRS.</p></article><article><h2>Director</h2><p>Revisa documentos y acompaña proyectos asignados.</p></article><article><h2>Evaluador</h2><p>Registra conceptos de evaluación.</p></article><article><h2>Comité</h2><p>Decide ideas, pagos, asignaciones y PQRS.</p></article><article><h2>Administrador</h2><p>Crea usuarios y modifica roles. No existe autorregistro.</p></article></div></section></main></body></html>