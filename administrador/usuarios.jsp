<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST' and not empty param.user_id}"><sql:update dataSource="${db}">UPDATE usuario SET rol=? WHERE id=?<sql:param value="${param.rol}"/><sql:param value="${param.user_id}"/></sql:update></c:if><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO usuario(documento,nombre,correo,password_sha256,rol) VALUES(?,?,?,SHA2(?,256),?)<sql:param value="${param.documento}"/><sql:param value="${param.nombre}"/><sql:param value="${param.correo}"/><sql:param value="${param.password}"/><sql:param value="${param.rol}"/></sql:update></c:if><sql:query dataSource="${db}" var="users">SELECT id,documento,nombre,correo,rol,activo FROM usuario ORDER BY id DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Usuarios · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><a class="back-link" href="../dashboard.jsp">← Panel principal</a><b>UTS · Administración</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ADMINISTRACIÓN</div><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a class="active" href="usuarios.jsp">Usuarios</a><a href="docentes.jsp">Docentes</a><a href="roles.jsp">Roles</a><a href="parametros.jsp">Parámetros</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">CONTROL DE CUENTAS</p><h1>Usuarios</h1><div class="card"><strong>Solo el Administrador crea cuentas y asigna roles.</strong><p>El estudiante no tiene autorregistro.</p></div><form method="post"><label>Documento<input name="documento" required></label><label>Nombre<input name="nombre" required></label><label>Correo institucional<input type="email" name="correo" required></label><label>Contraseña inicial<input type="password" name="password" minlength="8" required></label><label>Rol<select name="rol" required><option>ESTUDIANTE</option><option>DIRECTOR</option><option>EVALUADOR</option><option>COMITE</option><option>ADMINISTRADOR</option></select></label><button>Crear usuario</button></form><h2>Usuarios registrados</h2><table><tr><th>Documento</th><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th><th>Rol</th></tr><c:forEach var="u" items="${users.rows}"><tr><td>${u.documento}</td><td>${u.nombre}</td><td>${u.correo}</td><td>${u.rol}</td><td>${u.activo}</td></tr></c:forEach></table></section></main></body></html>