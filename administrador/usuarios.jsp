<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="users">SELECT documento,nombre,correo,rol,activo,creado_en FROM usuario ORDER BY creado_en DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Usuarios</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Administración</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Usuarios</h1><table><tr><th>Documento</th><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th></tr><c:forEach var="u" items="${users.rows}"><tr><td>${u.documento}</td><td>${u.nombre}</td><td>${u.correo}</td><td>${u.rol}</td><td>${u.activo}</td></tr></c:forEach></table></main></body></html>