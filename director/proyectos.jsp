<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT p.codigo,p.titulo,p.estado,p.etapa FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA' ORDER BY p.id DESC LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Proyectos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="dashboard.jsp">Resumen</a><a class="active" href="proyectos.jsp">Proyectos asignados</a><a href="revision.jsp">Revisión documental</a><a href="../pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">PROYECTOS ASIGNADOS</p><h1>Mis proyectos</h1><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th></tr><c:forEach var="p" items="${rows.rows}"><tr><td>${p.codigo}</td><td>${p.titulo}</td><td>${p.estado}</td><td>${p.etapa}/6</td></tr></c:forEach></table></section></main></body></html>