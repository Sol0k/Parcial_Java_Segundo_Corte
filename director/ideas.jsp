<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO idea(titulo,descripcion,nivel,modalidad,estado,creado_por) VALUES(?,?,?,?,?,?)<sql:param value="${param.titulo}"/><sql:param value="${param.descripcion}"/><sql:param value="${param.nivel}"/><sql:param value="${param.modalidad}"/><sql:param value="PENDIENTE"/><sql:param value="${sessionScope.auth.id}"/></sql:update><c:set var="ok" value="Idea publicada y enviada al Comité para revisión."/></c:if><sql:query dataSource="${db}" var="ideas">SELECT titulo,descripcion,nivel,modalidad,estado,creado_en FROM idea WHERE creado_por=? ORDER BY id DESC<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Banco de ideas · Director</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Dirección</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a class="active" href="ideas.jsp">Banco de ideas</a><a href="proyectos.jsp">Proyectos asignados</a><a href="revision.jsp">Revisión documental</a><a href="seguimientos.jsp">Seguimientos</a></aside><section class="content"><p class="section-kicker">PROPUESTA ACADÉMICA</p><h1>Banco de ideas</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><form method="post"><label>Título<input name="titulo" required></label><label>Descripción<textarea name="descripcion" required></textarea></label><label>Nivel<select name="nivel"><option>Profesional</option><option>Tecnológico</option></select></label><label>Modalidad<select name="modalidad"><option>Proyecto</option><option>Monografía</option><option>Práctica</option><option>Seminario</option><option>Desarrollo Tecnológico</option></select></label><button>Publicar idea</button></form><h2>Mis ideas</h2><table><tr><th>Título</th><th>Nivel</th><th>Modalidad</th><th>Estado</th><th>Fecha</th></tr><c:forEach var="i" items="${ideas.rows}"><tr><td>${i.titulo}</td><td>${i.nivel}</td><td>${i.modalidad}</td><td><span class="badge">${i.estado}</span></td><td>${i.creado_en}</td></tr></c:forEach></table></section></main></body></html>