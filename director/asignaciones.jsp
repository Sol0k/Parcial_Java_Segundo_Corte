<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE asignacion SET estado=? WHERE id=? AND docente_id=? AND tipo='DIRECTOR' AND estado='PROPUESTA'<sql:param value="${param.estado}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT a.id,p.codigo,p.titulo,u.nombre,a.estado FROM asignacion a JOIN proyecto p ON p.id=a.proyecto_id JOIN usuario u ON u.id=p.creado_por WHERE a.docente_id=? AND a.tipo='DIRECTOR' ORDER BY a.id DESC<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Propuestas de dirección</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Dirección</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a class="active" href="asignaciones.jsp">Propuestas de dirección</a><a href="proyectos.jsp">Proyectos asignados</a><a href="revision.jsp">Revisión documental</a><a href="seguimientos.jsp">Seguimientos</a></aside><section class="content"><h1>Propuestas de dirección</h1><table><tr><th>Proyecto</th><th>Solicitante</th><th>Estado</th><th>Acción</th></tr><c:forEach var="a" items="${rows.rows}"><tr><td>${a.codigo} · ${a.titulo}</td><td>${a.nombre}</td><td><span class="badge">${a.estado}</span></td><td><c:if test="${a.estado=='PROPUESTA'}"><form method="post"><input type="hidden" name="id" value="${a.id}"><button name="estado" value="ACTIVA">Aceptar</button><button name="estado" value="RECHAZADA">Rechazar</button></form></c:if></td></tr></c:forEach></table></section></main></body></html>