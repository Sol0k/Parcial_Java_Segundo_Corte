<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO historial(usuario_id,entidad,entidad_id,accion,observaciones) SELECT ?, 'PROYECTO', a.proyecto_id, 'SEGUIMIENTO_DIRECTOR', ? FROM asignacion a WHERE a.proyecto_id=? AND a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA'<sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="projects">SELECT p.id,p.codigo,p.titulo FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA'<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Seguimientos</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Dirección</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="dashboard.jsp">Resumen</a><a href="proyectos.jsp">Proyectos asignados</a><a href="revision.jsp">Revisión documental</a><a class="active" href="seguimientos.jsp">Seguimientos</a></aside><section class="content"><p class="section-kicker">ACOMPAÑAMIENTO</p><h1>Seguimientos académicos</h1><c:forEach var="p" items="${projects.rows}"><form method="post"><input type="hidden" name="proyecto_id" value="${p.id}"><h2>${p.codigo} · ${p.titulo}</h2><label>Observaciones<textarea name="observaciones" required></textarea></label><button>Registrar seguimiento</button></form></c:forEach></section></main></body></html>