<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE documento d JOIN asignacion a ON a.proyecto_id=d.proyecto_id SET d.estado=?,d.observaciones=? WHERE d.id=? AND a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado IN ('ACTIVA','PROPUESTA')<sql:param value="${param.estado}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update><c:if test="${param.estado=='APROBADO'}"><sql:update dataSource="${db}">UPDATE proyecto p JOIN documento d ON d.proyecto_id=p.id SET p.etapa=LEAST(p.etapa+1,6) WHERE d.id=? AND d.estado='APROBADO' AND p.etapa=CASE d.tipo WHEN 'Anteproyecto' THEN 1 WHEN 'Propuesta aprobada' THEN 2 WHEN 'Avance 1' THEN 3 WHEN 'Avance 2' THEN 4 WHEN 'Informe final' THEN 5 WHEN 'Sustentación' THEN 6 ELSE p.etapa END<sql:param value="${param.id}"/></sql:update></c:if></c:if><sql:query dataSource="${db}" var="projects">SELECT DISTINCT p.id,p.codigo,p.titulo,p.estado,p.etapa FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado IN ('ACTIVA','PROPUESTA') ORDER BY p.id DESC<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="docs">SELECT d.id,p.codigo,d.tipo,d.url,d.estado,d.observaciones FROM documento d JOIN proyecto p ON p.id=d.proyecto_id JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado IN ('ACTIVA','PROPUESTA') AND p.id=? ORDER BY d.id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.project}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Revisión documental · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Revisión documental</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="asignaciones.jsp">Propuestas de dirección</a><a href="proyectos.jsp">Proyectos asignados</a><a class="active" href="revision.jsp">Revisión documental</a><a href="seguimientos.jsp">Seguimientos</a></aside><section class="content"><p class="section-kicker">REVISIÓN DOCUMENTAL</p><c:choose><c:when test="${empty param.project}"><h1>Selecciona un proyecto</h1><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th><th>Acción</th></tr><c:forEach var="p" items="${projects.rows}"><tr><td>${p.codigo}</td><td>${p.titulo}</td><td>${p.estado}</td><td>${p.etapa}/6</td><td><a class="btn-link" href="revision.jsp?project=${p.id}">Ver documentos</a></td></tr></c:forEach></table></c:when><c:otherwise><a class="back-link" href="revision.jsp">← Volver a proyectos</a><h1>Documentos del proyecto</h1><table><tr><th>Proyecto</th><th>Tipo</th><th>Enlace</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td>${d.codigo}</td><td>${d.tipo}</td><td><a href="${d.url}" target="_blank">Abrir soporte</a></td><td><span class="badge">${d.estado}</span></td><td><form method="post"><input type="hidden" name="project" value="${param.project}"><input type="hidden" name="id" value="${d.id}"><select name="estado"><option>APROBADO</option><option>RECHAZADO</option><option>OBSERVADO</option></select><input name="observaciones" placeholder="Observaciones" required><button>Guardar</button></form></td></tr></c:forEach></table></c:otherwise></c:choose></section></main></body></html>