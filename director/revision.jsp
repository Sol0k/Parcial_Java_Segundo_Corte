<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE documento d JOIN asignacion a ON a.proyecto_id=d.proyecto_id SET d.estado=?,d.observaciones=? WHERE d.id=? AND a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA'<sql:param value="${param.estado}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="docs">SELECT d.id,p.codigo,d.tipo,d.url,d.estado,d.observaciones FROM documento d JOIN proyecto p ON p.id=d.proyecto_id JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA' ORDER BY d.id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Revisión · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">DIRECCIÓN</div><a href="dashboard.jsp">Resumen</a><a href="proyectos.jsp">Proyectos asignados</a><a class="active" href="revision.jsp">Revisión documental</a><a href="../pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">REVISIÓN DOCUMENTAL</p><h1>Documentos asignados</h1><table><tr><th>Proyecto</th><th>Tipo</th><th>Enlace</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td>${d.codigo}</td><td>${d.tipo}</td><td><a href="${d.url}" target="_blank">Abrir soporte</a></td><td>${d.estado}</td><td><form method="post"><input type="hidden" name="id" value="${d.id}"><select name="estado"><option>APROBADO</option><option>RECHAZADO</option><option>OBSERVADO</option></select><input name="observaciones" placeholder="Observaciones" required><button>Guardar</button></form></td></tr></c:forEach></table></section></main></body></html>