<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'DIRECTOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE documento d JOIN asignacion a ON a.proyecto_id=d.proyecto_id SET d.estado=?,d.observaciones=? WHERE d.id=? AND a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA'<sql:param value="${param.estado}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="docs">SELECT d.id,p.codigo,d.tipo,d.url,d.estado,d.observaciones FROM documento d JOIN proyecto p ON p.id=d.proyecto_id JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo='DIRECTOR' AND a.estado='ACTIVA' ORDER BY d.creado_en DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Revisión</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Revisión de documentos</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Documentos asignados</h1><table><tr><th>Proyecto</th><th>Tipo</th><th>Enlace</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td>${d.codigo}</td><td>${d.tipo}</td><td><a href="${d.url}" target="_blank">Abrir</a></td><td>${d.estado}</td><td><form method="post"><input type="hidden" name="id" value="${d.id}"><select name="estado"><option>APROBADO</option><option>RECHAZADO</option><option>OBSERVADO</option></select><input name="observaciones" placeholder="Observaciones" required><button>Guardar</button></form></td></tr></c:forEach></table></main></body></html>