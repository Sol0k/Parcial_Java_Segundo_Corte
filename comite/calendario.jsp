<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO calendario(nombre,apertura,cierre,activo) VALUES(?,?,?,TRUE)<sql:param value="${param.nombre}"/><sql:param value="${param.apertura}"/><sql:param value="${param.cierre}"/></sql:update></c:if><sql:query dataSource="${db}" var="periods">SELECT nombre,apertura,cierre,activo FROM calendario ORDER BY apertura DESC</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Calendario · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a class="active" href="calendario.jsp">Calendario</a></aside><section class="content"><p class="section-kicker">PLANEACIÓN</p><h1>Calendario académico</h1><form method="post"><label>Nombre del periodo<input name="nombre" placeholder="2026.2" required></label><label>Inicio<input type="date" name="apertura" required></label><label>Cierre<input type="date" name="cierre" required></label><button>Crear periodo</button></form><h2>Periodos académicos</h2><table><tr><th>Periodo</th><th>Inicio</th><th>Cierre</th><th>Estado</th></tr><c:forEach var="p" items="${periods.rows}"><tr><td>${p.nombre}</td><td>${p.apertura}</td><td>${p.cierre}</td><td>${p.activo ? 'Activo' : 'Inactivo'}</td></tr></c:forEach></table></section></main></body></html>