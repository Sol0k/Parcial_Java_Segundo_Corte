<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or (sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR')}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="projects">SELECT estado,COUNT(*) total FROM proyecto GROUP BY estado</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Reportes · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a class="active" href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a></aside><section class="content"><p class="section-kicker">INDICADORES</p><h1>Reportes por estado</h1><table><tr><th>Estado</th><th>Total</th></tr><c:forEach var="p" items="${projects.rows}"><tr><td>${p.estado}</td><td>${p.total}</td></tr></c:forEach></table></section></main></body></html>