<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or (sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR')}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE idea SET estado=? WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="ideas">SELECT id,titulo,descripcion,nivel,modalidad,estado FROM idea ORDER BY id DESC LIMIT 50</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Ideas · Comité</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><a href="../dashboard.jsp">Panel</a><a href="../logout.jsp">Cerrar sesión</a></header><main class="content"><h1>Gestión de ideas</h1><table><tr><th>Título</th><th>Nivel</th><th>Modalidad</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="i" items="${ideas.rows}"><tr><td>${i.titulo}</td><td>${i.nivel}</td><td>${i.modalidad}</td><td>${i.estado}</td><td><form method="post"><input type="hidden" name="id" value="${i.id}"><button name="estado" value="APROBADA">Aprobar</button> <button name="estado" value="RECHAZADA">Rechazar</button></form></td></tr></c:forEach></table></main></body></html>