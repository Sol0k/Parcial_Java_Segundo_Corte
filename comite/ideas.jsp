<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth or (sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR')}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE idea SET estado=? WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="ideas">SELECT i.id,i.titulo,i.descripcion,i.nivel,i.modalidad,i.estado,u.nombre,u.rol FROM idea i JOIN usuario u ON u.id=i.creado_por ORDER BY id DESC LIMIT 50</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Ideas · Comité</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a class="active" href="ideas.jsp">Ideas pendientes</a><a href="pagos.jsp">Pagos</a><a href="reportes.jsp">Reportes</a><a href="../pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">DECISIONES</p><h1>Gestión de ideas</h1><table><tr><th>Título</th><th>Nivel</th><th>Modalidad</th><th>Estado</th><th>Propuesta por</th><th>Acción</th></tr><c:forEach var="i" items="${ideas.rows}"><tr><td>${i.titulo}</td><td>${i.nivel}</td><td>${i.modalidad}</td><td>${i.estado}</td><td>${i.nombre} · ${i.rol}</td><td><c:if test="${i.estado == 'PENDIENTE'}"><form method="post"><input type="hidden" name="id" value="${i.id}"><button name="estado" value="APROBADA">Aprobar</button> <button name="estado" value="RECHAZADA">Rechazar</button></form></c:if><c:if test="${i.estado ne 'PENDIENTE'}"><span class="badge">Decidida</span></c:if></td></tr></c:forEach></table></section></main></body></html>