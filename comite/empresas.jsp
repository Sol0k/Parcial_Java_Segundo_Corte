<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO parametro(clave,valor) VALUES(?,?) ON DUPLICATE KEY UPDATE valor=VALUES(valor)<sql:param value="empresa_${param.nit}"/><sql:param value="${param.razon}| ${param.contacto}| ${param.correo}| ${param.telefono}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT clave,valor FROM parametro WHERE clave LIKE 'empresa_%' ORDER BY clave</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Empresas · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a><a class="active" href="festivos.jsp">Días festivos</a><a href="empresas.jsp">Empresas de práctica</a><a href="requisitos.jsp">Requisitos documentales</a><a href="inscripcion_docentes.jsp">Inscripción de docentes</a></aside><section class="content"><p class="section-kicker">PRÁCTICAS</p><h1>Empresas de práctica</h1><p>Empresas disponibles para convenios de práctica.</p><form method="post" class="card"><h2>Nueva empresa</h2><div class="form-grid"><label>NIT<input name="nit" required></label><label>Razón social<input name="razon" required></label><label>Contacto<input name="contacto" required></label><label>Correo del contacto<input type="email" name="correo" required></label><label>Teléfono<input name="telefono" required></label></div><button>Crear empresa</button></form><table><tr><th>NIT</th><th>Razón social</th><th>Contacto</th><th>Datos</th></tr><c:choose><c:when test="${rows.rowCount==0}"><tr><td colspan="4"><div class="empty-state">Aún no hay empresas registradas.</div></td></tr></c:when><c:otherwise><c:forEach var="r" items="${rows.rows}"><tr><td>${r.clave.substring(8)}</td><td>${r.valor}</td><td>Registrado</td><td>${r.valor}</td></tr></c:forEach></c:otherwise></c:choose></table></section></main></body></html>