<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="periods">SELECT id,nombre,apertura,cierre,activo FROM calendario ORDER BY apertura DESC</sql:query><c:set var="periodo" value="${empty param.periodo ? periods.rows[0].id : param.periodo}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO inscripcion_docente_periodo(periodo_id,docente_id,puede_dirigir,puede_evaluar,limite_proyectos) VALUES(?,?,?,?,?) ON DUPLICATE KEY UPDATE puede_dirigir=VALUES(puede_dirigir),puede_evaluar=VALUES(puede_evaluar),limite_proyectos=VALUES(limite_proyectos)<sql:param value="${param.periodo_id}"/><sql:param value="${param.docente_id}"/><sql:param value="${empty param.puede_dirigir ? 0 : 1}"/><sql:param value="${empty param.puede_evaluar ? 0 : 1}"/><sql:param value="${param.limite_proyectos}"/></sql:update><c:set var="periodo" value="${param.periodo_id}"/></c:if><sql:query dataSource="${db}" var="teachers">SELECT u.id,u.nombre,u.documento,COALESCE(i.puede_dirigir,0) puede_dirigir,COALESCE(i.puede_evaluar,0) puede_evaluar,COALESCE(i.limite_proyectos,0) limite_proyectos,(SELECT COUNT(*) FROM asignacion a WHERE a.docente_id=u.id AND a.tipo='DIRECTOR' AND a.estado IN ('ACTIVA','PROPUESTA')) dirigiendo FROM usuario u JOIN docente d ON d.usuario_id=u.id LEFT JOIN inscripcion_docente_periodo i ON i.docente_id=u.id AND i.periodo_id=? WHERE u.activo=1 ORDER BY u.nombre<sql:param value="${periodo}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Inscripción de docentes · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a><a class="active" href="inscripcion_docentes.jsp">Inscripción de docentes</a><a href="festivos.jsp">Días festivos</a><a href="empresas.jsp">Empresas de práctica</a><a href="requisitos.jsp">Requisitos documentales</a></aside><section class="content"><p class="section-kicker">PLANEACIÓN ACADÉMICA</p><h1>Inscripción de docentes por periodo</h1><p>Cada periodo define quién puede dirigir o evaluar y cuántos proyectos puede dirigir cada docente.</p><form method="get" class="card"><label>Periodo<select name="periodo"><c:forEach var="p" items="${periods.rows}"><option value="${p.id}" ${p.id==periodo?'selected':''}>${p.nombre} (${p.activo?'activo':'cerrado'})</option></c:forEach></select></label><button>Ver</button></form><table><tr><th>Docente</th><th>Cédula</th><th>Puede dirigir</th><th>Puede evaluar</th><th>Límite</th><th>Dirigiendo</th><th>Acción</th></tr><c:choose><c:when test="${teachers.rowCount==0}"><tr><td colspan="7"><div class="empty-state">No hay docentes registrados.</div></td></tr></c:when><c:otherwise><c:forEach var="t" items="${teachers.rows}"><tr><form method="post"><td>${t.nombre}</td><td>${t.documento}</td><td><input type="checkbox" name="puede_dirigir" ${t.puede_dirigir==1?'checked':''}></td><td><input type="checkbox" name="puede_evaluar" ${t.puede_evaluar==1?'checked':''}></td><td><input type="number" min="0" name="limite_proyectos" value="${t.limite_proyectos}" required></td><td>${t.dirigiendo}</td><td><input type="hidden" name="periodo_id" value="${periodo}"><input type="hidden" name="docente_id" value="${t.id}"><button>Guardar</button></td></form></tr></c:forEach></c:otherwise></c:choose></table></section></main></body></html>