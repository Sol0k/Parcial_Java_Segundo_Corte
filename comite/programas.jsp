<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO parametro(clave,valor) VALUES(?,?) ON DUPLICATE KEY UPDATE valor=VALUES(valor)<sql:param value="programa_${param.codigo}"/><sql:param value="${param.nombre}"/></sql:update><c:if test="${param.estudiante_id ne ''}"><sql:update dataSource="${db}">UPDATE estudiante SET programa=? WHERE usuario_id=?<sql:param value="${param.nombre}"/><sql:param value="${param.estudiante_id}"/></sql:update></c:if></c:if><sql:query dataSource="${db}" var="programas">SELECT clave,valor FROM parametro WHERE clave LIKE 'programa_%' ORDER BY valor</sql:query><sql:query dataSource="${db}" var="students">SELECT u.id,u.nombre,u.documento,e.programa FROM usuario u JOIN estudiante e ON e.usuario_id=u.id ORDER BY u.nombre</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Programas académicos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a class="active" href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a><a href="festivos.jsp">Días festivos</a><a href="empresas.jsp">Empresas de práctica</a><a href="requisitos.jsp">Requisitos documentales</a></aside><section class="content"><p class="section-kicker">CONFIGURACIÓN ACADÉMICA</p><h1>Programas académicos</h1><form method="post"><label>Código<input name="codigo" placeholder="ISI" required></label><label>Nombre del programa<input name="nombre" placeholder="Ingeniería de Sistemas" required></label><label>Asignar a estudiante<select name="estudiante_id"><option value="">Solo crear programa</option><c:forEach var="s" items="${students.rows}"><option value="${s.id}">${s.nombre} · ${s.programa}</option></c:forEach></select></label><button>Guardar programa</button></form><h2>Programas registrados</h2><table><tr><th>Código</th><th>Programa</th></tr><c:forEach var="p" items="${programas.rows}"><tr><td>${p.clave}</td><td>${p.valor}</td></tr></c:forEach></table><h2>Estudiantes y programa</h2><table><tr><th>Estudiante</th><th>Documento</th><th>Programa</th></tr><c:forEach var="s" items="${students.rows}"><tr><td>${s.nombre}</td><td>${s.documento}</td><td>${s.programa}</td></tr></c:forEach></table></section></main></body></html>