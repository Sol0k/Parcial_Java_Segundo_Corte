<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO integrante(proyecto_id,usuario_id) SELECT h.entidad_id,CAST(h.observaciones AS UNSIGNED) FROM historial h WHERE h.id=? AND h.accion='SOLICITUD_INTEGRANTE'<sql:param value="${param.id}"/></sql:update><sql:update dataSource="${db}">UPDATE historial SET accion=?,observaciones=? WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.estado}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT h.id,p.codigo,p.titulo,u.nombre solicitante,CAST(h.observaciones AS UNSIGNED) integrante_id,us.nombre integrante FROM historial h JOIN proyecto p ON p.id=h.entidad_id JOIN usuario u ON u.id=h.usuario_id JOIN usuario us ON us.id=CAST(h.observaciones AS UNSIGNED) WHERE h.accion='SOLICITUD_INTEGRANTE' ORDER BY h.id DESC</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Solicitudes de integrantes</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a class="active" href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a></aside><section class="content"><h1>Solicitudes de integrantes</h1><table><tr><th>Proyecto</th><th>Solicitante</th><th>Nuevo integrante</th><th>Acción</th></tr><c:forEach var="r" items="${rows.rows}"><tr><td>${r.codigo} · ${r.titulo}</td><td>${r.solicitante}</td><td>${r.integrante}</td><td><form method="post"><input type="hidden" name="id" value="${r.id}"><button name="estado" value="APROBADA">Aprobar</button><button name="estado" value="RECHAZADA">Rechazar</button></form></td></tr></c:forEach></table></section></main></body></html>