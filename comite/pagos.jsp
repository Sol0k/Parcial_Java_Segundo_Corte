<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE pago SET estado=?,observaciones=? WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="payments">SELECT pa.id,p.codigo,pa.tipo,pa.url,pa.estado,pa.observaciones FROM pago pa JOIN proyecto p ON p.id=pa.proyecto_id ORDER BY pa.creado_en DESC LIMIT 50</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Pagos</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité de pagos</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Verificación de pagos</h1><table><tr><th>Proyecto</th><th>Tipo</th><th>Soporte</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="p" items="${payments.rows}"><tr><td>${p.codigo}</td><td>${p.tipo}</td><td><a href="${p.url}" target="_blank">Abrir</a></td><td>${p.estado}</td><td><form method="post"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option>APROBADO</option><option>RECHAZADO</option></select><input name="observaciones" required><button>Resolver</button></form></td></tr></c:forEach></table></main></body></html>