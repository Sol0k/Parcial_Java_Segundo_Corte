<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE pago SET estado=?,observaciones=? WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="projects">SELECT p.id,p.codigo,p.titulo,p.estado,COUNT(pa.id) pagos FROM proyecto p JOIN pago pa ON pa.proyecto_id=p.id GROUP BY p.id,p.codigo,p.titulo,p.estado ORDER BY p.id DESC</sql:query><sql:query dataSource="${db}" var="payments">SELECT pa.id,p.codigo,p.titulo,pa.tipo,pa.url,pa.estado,pa.observaciones FROM pago pa JOIN proyecto p ON p.id=pa.proyecto_id WHERE p.id=? ORDER BY pa.id DESC<sql:param value="${param.project}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Pagos · Comité</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a class="active" href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a></aside><section class="content"><p class="section-kicker">VERIFICACIÓN</p><c:choose><c:when test="${empty param.project}"><h1>Pagos por proyecto</h1><table><tr><th>Código</th><th>Proyecto</th><th>Estado</th><th>Pagos</th><th>Acción</th></tr><c:forEach var="p" items="${projects.rows}"><tr><td>${p.codigo}</td><td>${p.titulo}</td><td>${p.estado}</td><td>${p.pagos}</td><td><a class="btn-link" href="pagos.jsp?project=${p.id}">Ver pagos</a></td></tr></c:forEach></table></c:when><c:otherwise><a class="back-link" href="pagos.jsp">← Volver a proyectos</a><h1>Pagos del proyecto</h1><table><tr><th>Tipo</th><th>Soporte</th><th>Estado</th><th>Decisión</th></tr><c:forEach var="p" items="${payments.rows}"><tr><td>${p.tipo}</td><td><a href="${p.url}" target="_blank">Abrir soporte</a></td><td><span class="badge">${p.estado}</span></td><td><form method="post"><input type="hidden" name="project" value="${param.project}"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option>APROBADO</option><option>RECHAZADO</option></select><input name="observaciones" placeholder="Observaciones" required><button>Resolver</button></form></td></tr></c:forEach></table></c:otherwise></c:choose></section></main></body></html>