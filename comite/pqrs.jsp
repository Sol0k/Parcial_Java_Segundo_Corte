<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">UPDATE pqrs SET estado=?,respuesta=?,fecha_respuesta=NOW() WHERE id=?<sql:param value="${param.estado}"/><sql:param value="${param.respuesta}"/><sql:param value="${param.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT p.id,p.tipo,p.asunto,p.descripcion,p.estado,p.respuesta,p.creado_en,u.nombre,u.correo FROM pqrs p JOIN usuario u ON u.id=p.usuario_id ORDER BY p.id DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>PQRS · Comité</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a class="active" href="pqrs.jsp">PQRS</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a></aside><section class="content"><p class="section-kicker">ATENCIÓN INSTITUCIONAL</p><h1>Revisión de PQRS</h1><table><tr><th>Solicitante</th><th>Tipo</th><th>Asunto</th><th>Estado</th><th>Respuesta</th></tr><c:forEach var="p" items="${rows.rows}"><tr><td>${p.nombre}</td><td>${p.tipo}</td><td>${p.asunto}<br><small>${p.descripcion}</small></td><td>${p.estado}</td><td><form method="post"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option>EN_REVISION</option><option>RESPONDIDA</option><option>CERRADA</option></select><textarea name="respuesta" required placeholder="Respuesta institucional"></textarea><button>Responder</button></form></td></tr></c:forEach></table></section></main></body></html>