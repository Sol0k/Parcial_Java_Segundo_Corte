<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO parametro(clave,valor) VALUES(?,?) ON DUPLICATE KEY UPDATE valor=VALUES(valor)<sql:param value="festivo_${param.fecha}"/><sql:param value="${param.descripcion}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT clave,valor FROM parametro WHERE clave LIKE 'festivo_%' ORDER BY clave DESC</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Días festivos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a href="integrantes.jsp">Integrantes</a><a href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="pqrs.jsp">PQRS</a><a href="programas.jsp">Programas académicos</a><a href="reportes.jsp">Reportes</a><a href="calendario.jsp">Calendario</a><a class="active" href="festivos.jsp">Días festivos</a><a href="empresas.jsp">Empresas de práctica</a><a href="requisitos.jsp">Requisitos documentales</a><a href="inscripcion_docentes.jsp">Inscripción de docentes</a></aside><section class="content"><p class="section-kicker">PLANEACIÓN</p><h1>Días festivos</h1><p>Se usan para calcular los días hábiles de revisión del evaluador.</p><form method="post" class="card"><h2>Agregar día festivo</h2><label>Fecha<input type="date" name="fecha" required></label><label>Descripción<input name="descripcion" required></label><button>Agregar</button></form><table><tr><th>Fecha</th><th>Descripción</th></tr><c:choose><c:when test="${rows.rowCount==0}"><tr><td colspan="2"><div class="empty-state">Aún no hay días festivos registrados.</div></td></tr></c:when><c:otherwise><c:forEach var="r" items="${rows.rows}"><tr><td>${r.clave.substring(8)}</td><td>${r.valor}</td></tr></c:forEach></c:otherwise></c:choose></table></section></main></body></html>