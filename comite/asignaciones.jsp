<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'COMITE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT p.codigo,p.titulo,u.nombre,d.tipo,a.estado FROM asignacion a JOIN proyecto p ON p.id=a.proyecto_id JOIN docente d ON d.usuario_id=a.docente_id JOIN usuario u ON u.id=d.usuario_id ORDER BY a.id DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Asignaciones</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Comité</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">COMITÉ</div><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Ideas pendientes</a><a class="active" href="asignaciones.jsp">Asignaciones</a><a href="pagos.jsp">Pagos</a><a href="reportes.jsp">Reportes</a></aside><section class="content"><p class="section-kicker">DOCENTES</p><h1>Asignaciones vigentes</h1><table><tr><th>Proyecto</th><th>Título</th><th>Docente</th><th>Tipo</th><th>Estado</th></tr><c:forEach var="a" items="${rows.rows}"><tr><td>${a.codigo}</td><td>${a.titulo}</td><td>${a.nombre}</td><td>${a.tipo}</td><td>${a.estado}</td></tr></c:forEach></table></section></main></body></html>