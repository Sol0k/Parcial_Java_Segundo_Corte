<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth}"><c:redirect url="login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO pqrs(usuario_id,tipo,asunto,descripcion) VALUES(?,?,?,?)<sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.tipo}"/><sql:param value="${param.asunto}"/><sql:param value="${param.descripcion}"/></sql:update></c:if><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>PQRS · UTS</title><link rel="stylesheet" href="assets/css/estilos.css"></head><body><header><b>UTS · PQRS</b><span>${sessionScope.auth.nombre}</span><a href="dashboard.jsp">Panel principal</a><a href="logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ATENCIÓN</div><a class="active" href="pqrs.jsp">PQRS</a><a href="dashboard.jsp">Panel principal</a><a href="logout.jsp">Cerrar sesión</a></aside><section class="content"><p class="section-kicker">ATENCIÓN INSTITUCIONAL</p><h1>PQRS</h1><form method="post"><label>Tipo<select name="tipo"><option>PETICION</option><option>QUEJA</option><option>RECLAMO</option><option>SUGERENCIA</option></select></label><label>Asunto<input name="asunto" required></label><label>Descripción<textarea name="descripcion" required></textarea></label><button>Registrar solicitud</button></form></section></main></body></html>