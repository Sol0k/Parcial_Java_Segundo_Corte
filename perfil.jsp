<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><c:if test="${empty sessionScope.auth}"><c:redirect url="login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><c:choose><c:when test="${empty param.password}"><sql:update dataSource="${db}">UPDATE usuario SET nombre=?,correo=? WHERE id=?<sql:param value="${param.nombre}"/><sql:param value="${param.correo}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:when><c:otherwise><sql:update dataSource="${db}">UPDATE usuario SET nombre=?,correo=?,password_sha256=SHA2(?,256) WHERE id=?<sql:param value="${param.nombre}"/><sql:param value="${param.correo}"/><sql:param value="${param.password}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:otherwise></c:choose><c:set var="ok" value="Perfil actualizado correctamente."/></c:if><sql:query dataSource="${db}" var="u">SELECT documento,nombre,correo,rol FROM usuario WHERE id=?<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Mi perfil · UTS</title><link rel="stylesheet" href="assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="dashboard.jsp">Panel principal</a><a href="logout.jsp">Cerrar sesión</a></header><main class="content"><p class="section-kicker">CUENTA PERSONAL</p><h1>Actualizar perfil</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><c:forEach var="x" items="${u.rows}"><form method="post"><label>Documento<input value="${x.documento}" disabled></label><label>Nombre<input name="nombre" value="${x.nombre}" required></label><label>Correo institucional<input type="email" name="correo" value="${x.correo}" required></label><label>Nueva contraseña<input type="password" name="password" minlength="8" placeholder="Dejar vacío para conservarla"></label><p>Rol actual: <b>${x.rol}</b>. El rol solo puede modificarlo el Administrador.</p><button>Guardar cambios</button></form></c:forEach></main></body></html>