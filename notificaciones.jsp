<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT mensaje,leida,creado_en FROM notificacion WHERE usuario_id=? ORDER BY id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Notificaciones · UTS</title><link rel="stylesheet" href="assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="dashboard.jsp">Panel principal</a><a href="logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">ACTUALIZACIONES</div><a class="active" href="notificaciones.jsp">Notificaciones</a><a href="dashboard.jsp">Panel principal</a></aside><section class="content"><p class="section-kicker">ACTUALIZACIONES</p><h1>Notificaciones</h1><table><tr><th>Mensaje</th><th>Estado</th><th>Fecha</th></tr><c:forEach var="n" items="${rows.rows}"><tr><td>${n.mensaje}</td><td>${n.leida ? 'Leída' : 'Nueva'}</td><td>${n.creado_en}</td></tr></c:forEach></table></main></body></html>