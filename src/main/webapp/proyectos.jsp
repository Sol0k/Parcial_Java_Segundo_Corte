<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:useBean id="page" class="co.edu.uts.web.PageBean" scope="request"/><% page.setRequest(request); %><c:if test="${!page.logged}"><c:redirect url="${pageContext.request.contextPath}/login.jsp"/></c:if><jsp:useBean id="action" class="co.edu.uts.web.ActionBean" scope="request"/><% action.setRequest(request); %><c:if test="${pageContext.request.method=='POST'}"><c:set var="x" value="${action.process()}"/><c:if test="${not empty action.redirect}"><c:redirect url="${action.redirect}"/></c:if></c:if><!doctype html><html><head><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Proyectos</title></head><body><aside class="sidebar"><a class="brand-link" href="${pageContext.request.contextPath}/inicio.jsp"><b class="brand-mark">TG</b> Trabajos de grado</a><nav><a class="nav-link" href="${pageContext.request.contextPath}/inicio.jsp">Inicio</a><a class="nav-link" href="${pageContext.request.contextPath}/ideas.jsp">Ideas</a><a class="nav-link" href="${pageContext.request.contextPath}/proyectos.jsp">Proyectos</a><a class="nav-link" href="${pageContext.request.contextPath}/practicas.jsp">Prácticas</a><a class="nav-link" href="${pageContext.request.contextPath}/entregables.jsp">Entregables</a><a class="nav-link" href="${pageContext.request.contextPath}/evaluaciones.jsp">Evaluaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/solicitudes.jsp">Solicitudes</a><a class="nav-link" href="${pageContext.request.contextPath}/paso-a-grado.jsp">Paso a grado</a><a class="nav-link" href="${pageContext.request.contextPath}/periodos.jsp">Periodos</a><a class="nav-link" href="${pageContext.request.contextPath}/pqrs.jsp">PQRS</a><a class="nav-link" href="${pageContext.request.contextPath}/reportes.jsp">Reportes</a><a class="nav-link" href="${pageContext.request.contextPath}/notificaciones.jsp">Notificaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/docentes.jsp">Usuarios</a></nav><div class="sidebar-user">${user.nombre}<br><small>${user.rol}</small><br><a href="${pageContext.request.contextPath}/logout.jsp">Salir</a></div></aside><main class="content"><header class="topbar"><span>proyectos</span><b>${user.nombre}</b></header><section class="page-heading"><h1>Proyectos</h1></section><section class="module-card"><form class="form-panel" method="post"><input type="hidden" name="action" value="createProject"><input type="hidden" name="returnPage" value="createProject.jsp"><input type="hidden" name="csrf" value="${page.csrfToken}"><input class="form-control" name="ideaId" placeholder="ID idea"><input class="form-control" name="codigo" placeholder="Código"><input class="form-control" name="modalidad" placeholder="Modalidad"><button class="btn btn-primary">Crear proyecto</button></form><c:forEach var="p" items="${page.projects}"><article class="item-card"><b>${p.codigo}</b> · ${p.titulo} · ${p.estado}</article></c:forEach></section></main></body></html>