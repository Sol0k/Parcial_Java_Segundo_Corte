<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trabajos de grado UTS</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="/app.css"></head>
<body><div class="app-shell"><aside class="sidebar" id="sidebar"><div class="brand"><span class="brand-mark">TG</span><div><strong>Trabajos de Grado</strong><small>UTS</small></div></div><nav class="nav flex-column"><a class="nav-link active" href="#inicio"><i class="bi bi-house"></i> Inicio</a><a class="nav-link" href="#ideas"><i class="bi bi-lightbulb"></i> Ideas</a><a class="nav-link" href="#proyectos"><i class="bi bi-folder"></i> Proyectos</a><a class="nav-link" href="#operaciones"><i class="bi bi-diagram-3"></i> Etapas y equipo</a><a class="nav-link" href="#entregables"><i class="bi bi-file-earmark-text"></i> Entregables</a><a class="nav-link" href="#evaluaciones"><i class="bi bi-mortarboard"></i> Evaluaciones</a><a class="nav-link" href="#solicitudes"><i class="bi bi-inbox"></i> Solicitudes</a><a class="nav-link" href="#calendario"><i class="bi bi-calendar3"></i> Calendario</a><a class="nav-link" href="#pqrs"><i class="bi bi-chat-left-text"></i> PQRS</a><a class="nav-link" href="#historial"><i class="bi bi-clock-history"></i> Historial</a><c:if test="${user.rol == 'ADMIN'}"><a class="nav-link" href="#usuarios"><i class="bi bi-people"></i> Usuarios</a></c:if></nav><div class="sidebar-user"><div class="avatar">${user.nombre.substring(0,1)}</div><div><strong>${user.nombre}</strong><small>${user.rol}</small></div><a href="/logout" class="logout"><i class="bi bi-box-arrow-right"></i></a></div></aside>
<main class="content"><div class="topbar"><button class="btn btn-light d-lg-none" id="menuBtn"><i class="bi bi-list"></i></button><span class="breadcrumb mb-0">Panel / Inicio</span><div class="top-actions"><i class="bi bi-bell"></i><span class="user-label">${user.nombre}</span></div></div><div class="notice-strip"><div><i class="bi bi-bell"></i> ${notificaciones.size()} notificaciones pendientes</div><form method="post" action="/notificaciones/leidas"><button class="btn btn-sm btn-link">Marcar como leídas</button></form></div>
<section id="inicio" class="welcome"><div><span class="eyebrow">PANEL PRINCIPAL</span><h1>Hola, ${user.nombre}</h1><p>Seguimiento integral del trabajo de grado.</p></div><div class="welcome-icon"><i class="bi bi-mortarboard-fill"></i></div></section><div class="section-label">RESUMEN</div><section class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-icon blue"><i class="bi bi-folder2-open"></i></span><div><strong>${proyectos.size()}</strong><small>Proyectos</small></div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-icon yellow"><i class="bi bi-lightbulb"></i></span><div><strong>${ideas.size()}</strong><small>Ideas</small></div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-icon green"><i class="bi bi-file-earmark-check"></i></span><div><strong>${documentos.size()}</strong><small>Documentos</small></div></div></div><div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-icon purple"><i class="bi bi-chat-left-dots"></i></span><div><strong>${pqrs.size()}</strong><small>PQRS</small></div></div></div></section>
<section id="ideas" class="module-card"><div class="module-heading"><div><span class="eyebrow">GESTIÓN</span><h2>Banco de ideas</h2></div><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newIdea"><i class="bi bi-plus-lg"></i> Nueva idea</button></div><div class="row g-3"><c:forEach var="i" items="${ideas}"><div class="col-md-6"><div class="item-card"><div class="d-flex justify-content-between gap-2"><h3>${i.titulo}</h3><span class="status">${i.estado}</span></div><p>${i.descripcion}</p><small>Nivel ${i.nivel}</small><c:if test="${user.rol == 'ESTUDIANTE' && i.estado == 'DISPONIBLE'}"><form method="post" action="/ideas/${i.id}/seleccionar"><button class="btn btn-sm btn-outline-primary mt-2">Seleccionar idea</button></form></c:if><c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form class="mt-2" method="post" action="/ideas/${i.id}/decision"><div class="input-group"><select class="form-select" name="estado"><option>APROBADA</option><option>RECHAZADA</option></select><input class="form-control" name="observaciones" placeholder="Observaciones"><button class="btn btn-outline-primary">Decidir</button></div></form></c:if></div></div></c:forEach></div><div id="newIdea" class="collapse mt-3"><form class="form-panel" method="post" action="/ideas"><div class="row g-2"><div class="col-md-6"><input class="form-control" name="titulo" placeholder="Título" required></div><div class="col-md-2"><input class="form-control" name="nivel" type="number" min="1" placeholder="Nivel" required></div><div class="col-12"><textarea class="form-control" name="descripcion" placeholder="Descripción" required></textarea></div><div class="col-12"><button class="btn btn-primary">Guardar idea</button></div></div></form></div></section>
<section id="proyectos" class="module-card"><div class="module-heading"><div><span class="eyebrow">SEGUIMIENTO</span><h2>Proyectos</h2></div><a class="btn btn-outline-primary" href="/reportes/proyectos">CSV</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Código</th><th>Modalidad</th><th>Estado</th></tr></thead><tbody><c:forEach var="p" items="${proyectos}"><tr><td><strong>${p.codigo}</strong></td><td>${p.modalidad}</td><td><span class="status">${p.estado}</span></td></tr></c:forEach></tbody></table></div><c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form class="form-panel" method="post" action="/proyectos"><div class="row g-2"><div class="col-md-3"><input class="form-control" name="ideaId" type="number" placeholder="ID idea aprobada" required></div><div class="col-md-3"><input class="form-control" name="codigo" placeholder="CCC-AAAA.S-NN" required></div><div class="col-md-3"><input class="form-control" name="modalidad" placeholder="propuesta/monografia/proyecto" required></div><div class="col-md-3"><button class="btn btn-primary w-100">Crear proyecto</button></div></div></form></c:if></section>
<section id="operaciones" class="module-card"><div class="module-heading"><div><span class="eyebrow">OPERACIÓN</span><h2>Equipo, asignaciones y etapas</h2></div><form class="d-flex gap-2" method="get" action="/buscar"><input class="form-control" name="q" placeholder="Buscar"><button class="btn btn-outline-primary"><i class="bi bi-search"></i></button></form></div><div class="row g-3"><div class="col-lg-4"><form class="form-panel" method="post" action="/equipos"><h3>Equipo</h3><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="estudianteId" type="number" placeholder="ID estudiante" required><button class="btn btn-primary">Agregar integrante</button></form></div><div class="col-lg-4"><form class="form-panel" method="post" action="/asignaciones"><h3>Asignación docente</h3><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="docenteId" type="number" placeholder="ID docente" required><select class="form-select" name="tipo"><option>DIRECTOR</option><option>EVALUADOR</option><option>TERCER_EVALUADOR</option></select><button class="btn btn-primary">Asignar</button></form></div><div class="col-lg-4"><form class="form-panel" method="post" action="/etapas"><h3>Etapa</h3><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="numero" type="number" min="1" max="6" placeholder="1-6" required><select class="form-select" name="estado"><option>PENDIENTE</option><option>EN_CURSO</option><option>FINALIZADA</option></select><input class="form-control" name="fechaLimite" type="date"><button class="btn btn-primary">Guardar</button></form></div></div></section>
<section id="entregables" class="module-card"><div class="module-heading"><div><span class="eyebrow">ENTREGABLES</span><h2>Documentos y pagos por URL</h2></div></div><div class="row g-3"><div class="col-lg-6"><form class="form-panel" method="post" action="/documentos"><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="tipo" placeholder="FDC-124, FDC-125, Turnitin" required><input class="form-control" name="url" type="url" placeholder="https://..." required><button class="btn btn-primary">Registrar documento</button></form></div><div class="col-lg-6"><form class="form-panel" method="post" action="/pagos"><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="tipo" placeholder="Tipo de pago" required><input class="form-control" name="url" type="url" placeholder="https://..." required><button class="btn btn-primary">Registrar pago</button></form></div></div></section>
<section id="evaluaciones" class="module-card"><div class="module-heading"><div><span class="eyebrow">EVALUACIÓN</span><h2>Conceptos y firmas</h2></div></div><form class="form-panel" method="post" action="/evaluaciones"><div class="row g-2"><div class="col-md-3"><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required></div><div class="col-md-3"><input class="form-control" name="fase" placeholder="PROPUESTA / FINAL" required></div><div class="col-md-3"><select class="form-select" name="concepto"><option>APROBADO</option><option>APROBADO_CON_CORRECCIONES</option><option>NO_APROBADO</option></select></div><div class="col-md-3"><label class="form-check"><input class="form-check-input" name="firma" type="checkbox" value="true"> Firmar</label></div><div class="col-12"><textarea class="form-control" name="observaciones" placeholder="Observaciones obligatorias"></textarea><button class="btn btn-primary mt-2">Registrar evaluación</button></div></div></form></section>
<section id="solicitudes" class="module-card"><div class="module-heading"><div><span class="eyebrow">SOLICITUDES</span><h2>Prórrogas y seguimientos</h2></div></div><div class="row g-3"><div class="col-lg-6"><form class="form-panel" method="post" action="/prorrogas"><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><input class="form-control" name="cartaUrl" type="url" placeholder="URL carta" required><input class="form-control" name="pagoUrl" type="url" placeholder="URL pago" required><button class="btn btn-primary">Solicitar 180 días</button></form></div><div class="col-lg-6"><form class="form-panel" method="post" action="/seguimientos"><input class="form-control" name="proyectoId" type="number" placeholder="ID proyecto" required><textarea class="form-control" name="observaciones" placeholder="Seguimiento" required></textarea><button class="btn btn-primary">Registrar seguimiento</button></form></div></div></section>
<section id="calendario" class="module-card"><div class="module-heading"><div><span class="eyebrow">ACADÉMICO</span><h2>Calendario</h2></div></div><c:forEach var="c" items="${calendario}"><div class="calendar-row"><i class="bi bi-calendar-event"></i><strong>${c.evento}</strong><span>${c.inicio} — ${c.fin}</span></div></c:forEach><c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form class="form-panel mt-3" method="post" action="/calendario"><div class="row g-2"><div class="col-md-3"><input class="form-control" name="periodo" placeholder="2026-2" required></div><div class="col-md-3"><input class="form-control" name="evento" placeholder="Evento" required></div><div class="col-md-3"><input class="form-control" name="inicio" type="date" required></div><div class="col-md-3"><input class="form-control" name="fin" type="date" required></div><div class="col-12"><button class="btn btn-primary">Agregar fecha</button></div></div></form></c:if></section>
<section id="pqrs" class="module-card"><div class="module-heading"><div><span class="eyebrow">ATENCIÓN</span><h2>PQRS</h2></div></div><c:forEach var="q" items="${pqrs}"><div class="item-card mb-2"><strong>${q.asunto}</strong><span class="status">${q.estado}</span><p>${q.descripcion}</p></div></c:forEach><form class="form-panel" method="post" action="/pqrs"><input class="form-control" name="asunto" placeholder="Asunto" required><textarea class="form-control" name="descripcion" placeholder="Descripción" required></textarea><button class="btn btn-primary">Registrar PQRS</button></form></section>
<c:if test="${user.rol == 'ADMIN'}"><section id="usuarios" class="module-card"><div class="module-heading"><div><span class="eyebrow">ADMINISTRACIÓN</span><h2>Usuarios y parámetros</h2></div></div><form class="form-panel" method="post" action="/usuarios"><div class="row g-2"><div class="col-md-3"><input class="form-control" name="documento" placeholder="Documento" required></div><div class="col-md-3"><input class="form-control" name="nombre" placeholder="Nombre" required></div><div class="col-md-3"><input class="form-control" name="correo" type="email" placeholder="Correo institucional" required></div><div class="col-md-3"><select class="form-select" name="rol"><option>ESTUDIANTE</option><option>DIRECTOR</option><option>EVALUADOR</option><option>COMITE</option></select></div><div class="col-md-6"><input class="form-control" name="contrasena" placeholder="Contraseña inicial" required></div><div class="col-md-6"><button class="btn btn-primary w-100">Crear usuario</button></div></div></form><form class="form-panel mt-2" method="post" action="/parametros"><div class="row g-2"><div class="col-md-5"><input class="form-control" name="clave" placeholder="equipo_maximo_propuesta" required></div><div class="col-md-5"><input class="form-control" name="valor" placeholder="Valor" required></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Guardar</button></div></div></form></section></c:if>
<section id="historial" class="module-card"><div class="module-heading"><div><span class="eyebrow">TRAZABILIDAD</span><h2>Historial y paso a grado</h2></div><a class="btn btn-outline-primary" href="/reportes/proyectos">CSV</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Entidad</th><th>Acción</th><th>Detalle</th></tr></thead><tbody><c:forEach var="h" items="${historial}"><tr><td>${h.fecha}</td><td>${h.entidad}</td><td>${h.accion}</td><td>${h.detalle}</td></tr></c:forEach></tbody></table></div><form class="form-panel" method="post" action="/paso-a-grado"><input class="form-control" name="id" type="number" placeholder="ID proyecto para validar paso a grado" required><button class="btn btn-primary mt-2">Validar paso a grado</button></form></section>
</main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>document.getElementById('menuBtn')?.addEventListener('click',()=>document.getElementById('sidebar').classList.toggle('show'));</script></body></html>