<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Panel UTS</title><link rel="stylesheet" href="/app.css"></head>
<body><header><h1>Trabajos de grado UTS</h1><span>${user.nombre} · ${user.rol} · <a href="/logout">Salir</a></span></header><main class="grid">
<section class="card"><h2>Ideas</h2><c:forEach var="i" items="${ideas}"><article><b>${i.titulo}</b><p>${i.descripcion}</p><small>Nivel ${i.nivel} · ${i.estado}</small><c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form method="post" action="/ideas/${i.id}/decision"><select name="estado"><option>APROBADA</option><option>RECHAZADA</option></select><input name="observaciones" placeholder="Observaciones"><button>Decidir</button></form></c:if></article></c:forEach>
<form method="post" action="/ideas"><h3>Nueva idea</h3><input name="titulo" placeholder="Título" required><textarea name="descripcion" placeholder="Descripción" required></textarea><input name="nivel" type="number" min="1" required><button>Guardar</button></form></section>
<section class="card"><h2>Proyectos</h2><c:forEach var="p" items="${proyectos}"><article><b>${p.codigo}</b> · ${p.estado}<p>${p.modalidad}</p></article></c:forEach>
<c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form method="post" action="/proyectos"><input name="ideaId" type="number" placeholder="ID idea" required><input name="codigo" placeholder="CCC-AAAA.S-NN" required><input name="modalidad" placeholder="Modalidad" required><button>Crear proyecto</button></form></c:if>
<form method="post" action="/documentos"><h3>Documento por URL</h3><input name="proyectoId" type="number" required><input name="tipo" placeholder="FDC-124" required><input name="url" type="url" placeholder="https://..." required><button>Registrar</button></form>
<form method="post" action="/pagos"><h3>Pago por URL</h3><input name="proyectoId" type="number" required><input name="tipo" placeholder="Tipo de pago" required><input name="url" type="url" required><button>Registrar</button></form></section>
<section class="card"><h2>Evaluaciones</h2><c:forEach var="e" items="${evaluaciones}"><article>${e.fase} · ${e.concepto}<p>${e.observaciones}</p></article></c:forEach><form method="post" action="/evaluaciones"><input name="proyectoId" type="number" required><input name="fase" placeholder="PROPUESTA o FINAL" required><select name="concepto"><option>APROBADO</option><option>APROBADO_CON_CORRECCIONES</option><option>NO_APROBADO</option></select><textarea name="observaciones"></textarea><label><input name="firma" type="checkbox" value="true"> Firmar</label><button>Evaluar</button></form><h2>Prórroga</h2><form method="post" action="/prorrogas"><input name="proyectoId" type="number" required><input name="cartaUrl" type="url" placeholder="URL carta" required><input name="pagoUrl" type="url" placeholder="URL pago" required><button>Solicitar 180 días</button></form></section>
<section class="card"><h2>PQRS</h2><c:forEach var="q" items="${pqrs}"><article><b>${q.asunto}</b> · ${q.estado}<p>${q.descripcion}</p></article></c:forEach><form method="post" action="/pqrs"><input name="asunto" placeholder="Asunto" required><textarea name="descripcion" placeholder="Descripción" required></textarea><button>Registrar PQRS</button></form><h2>Calendario</h2><c:forEach var="c" items="${calendario}"><p>${c.evento}: ${c.inicio} - ${c.fin}</p></c:forEach><c:if test="${user.rol == 'COMITE' || user.rol == 'ADMIN'}"><form method="post" action="/calendario"><input name="periodo" placeholder="2026-2" required><input name="evento" placeholder="Evento" required><input name="inicio" type="date" required><input name="fin" type="date" required><button>Agregar fecha</button></form></c:if></section>
<c:if test="${user.rol == 'ADMIN'}"><section class="card"><h2>Crear usuario</h2><form method="post" action="/usuarios"><input name="documento" placeholder="Documento" required><input name="nombre" placeholder="Nombre" required><input name="correo" type="email" required><select name="rol"><option>ESTUDIANTE</option><option>DIRECTOR</option><option>EVALUADOR</option><option>COMITE</option></select><input name="contrasena" placeholder="Contraseña" required><button>Crear usuario</button></form></section></c:if>
</main></body></html>