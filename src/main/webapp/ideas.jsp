<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:useBean id="page" class="co.edu.uts.web.PageBean" scope="request"/><jsp:setProperty name="page" property="request"/><c:if test="${!page.logged}"><c:redirect url="${pageContext.request.contextPath}/login.jsp"/></c:if><jsp:useBean id="action" class="co.edu.uts.web.ActionBean" scope="request"/><jsp:setProperty name="action" property="request"/><c:if test="${pageContext.request.method=='POST'}"><c:set var="x" value="${action.process()}"/><c:if test="${not empty action.redirect}"><c:redirect url="${action.redirect}"/></c:if></c:if><!doctype html><html><head><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Banco de ideas</title></head><body><aside class="sidebar"><a class="brand-link" href="${pageContext.request.contextPath}/inicio.jsp"><b class="brand-mark">TG</b> Trabajos de grado</a><nav><a class="nav-link" href="${pageContext.request.contextPath}/inicio.jsp">Inicio</a><a class="nav-link" href="${pageContext.request.contextPath}/ideas.jsp">Ideas</a><a class="nav-link" href="${pageContext.request.contextPath}/proyectos.jsp">Proyectos</a><a class="nav-link" href="${pageContext.request.contextPath}/practicas.jsp">Prácticas</a><a class="nav-link" href="${pageContext.request.contextPath}/entregables.jsp">Entregables</a><a class="nav-link" href="${pageContext.request.contextPath}/evaluaciones.jsp">Evaluaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/solicitudes.jsp">Solicitudes</a><a class="nav-link" href="${pageContext.request.contextPath}/paso-a-grado.jsp">Paso a grado</a><a class="nav-link" href="${pageContext.request.contextPath}/periodos.jsp">Periodos</a><a class="nav-link" href="${pageContext.request.contextPath}/pqrs.jsp">PQRS</a><a class="nav-link" href="${pageContext.request.contextPath}/reportes.jsp">Reportes</a><a class="nav-link" href="${pageContext.request.contextPath}/notificaciones.jsp">Notificaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/docentes.jsp">Usuarios</a></nav><div class="sidebar-user">${user.nombre}<br><small>${user.rol}</small><br><a href="${pageContext.request.contextPath}/logout.jsp">Salir</a></div></aside><main class="content"><header class="topbar"><span>ideas</span><b>${user.nombre}</b></header><section class="page-heading"><h1>Banco de ideas</h1></section><section class="module-card"><form class="form-panel" method="post"><input type="hidden" name="action" value="createIdea"><input type="hidden" name="returnPage" value="createIdea.jsp"><input type="hidden" name="csrf" value="${page.csrfToken}"><input class="form-control" name="titulo" placeholder="Título"><textarea class="form-control" name="descripcion" placeholder="Descripción"></textarea><input class="form-control" name="nivel" placeholder="Nivel"><button class="btn btn-primary">Guardar idea</button></form><c:forEach var="i" items="${page.ideas}"><article class="item-card"><h3>${i.titulo}</h3><p>${i.descripcion}</p><span class="status">${i.estado}</span></article></c:forEach></section></main></body></html>