<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><jsp:useBean id="page" class="co.edu.uts.web.PageBean" scope="request"/><jsp:setProperty name="page" property="request"/><c:if test="${!page.logged}"><c:redirect url="${pageContext.request.contextPath}/login.jsp"/></c:if><jsp:useBean id="action" class="co.edu.uts.web.ActionBean" scope="request"/><jsp:setProperty name="action" property="request"/><c:if test="${pageContext.request.method=='POST'}"><c:set var="x" value="${action.process()}"/><c:if test="${not empty action.redirect}"><c:redirect url="${action.redirect}"/></c:if></c:if><!doctype html><html><head><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Inicio</title></head><body><aside class="sidebar"><a class="brand-link" href="${pageContext.request.contextPath}/inicio.jsp"><b class="brand-mark">TG</b> Trabajos de grado</a><nav><a class="nav-link" href="${pageContext.request.contextPath}/inicio.jsp">Inicio</a><a class="nav-link" href="${pageContext.request.contextPath}/ideas.jsp">Ideas</a><a class="nav-link" href="${pageContext.request.contextPath}/proyectos.jsp">Proyectos</a><a class="nav-link" href="${pageContext.request.contextPath}/practicas.jsp">Prácticas</a><a class="nav-link" href="${pageContext.request.contextPath}/entregables.jsp">Entregables</a><a class="nav-link" href="${pageContext.request.contextPath}/evaluaciones.jsp">Evaluaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/solicitudes.jsp">Solicitudes</a><a class="nav-link" href="${pageContext.request.contextPath}/paso-a-grado.jsp">Paso a grado</a><a class="nav-link" href="${pageContext.request.contextPath}/periodos.jsp">Periodos</a><a class="nav-link" href="${pageContext.request.contextPath}/pqrs.jsp">PQRS</a><a class="nav-link" href="${pageContext.request.contextPath}/reportes.jsp">Reportes</a><a class="nav-link" href="${pageContext.request.contextPath}/notificaciones.jsp">Notificaciones</a><a class="nav-link" href="${pageContext.request.contextPath}/docentes.jsp">Usuarios</a></nav><div class="sidebar-user">${user.nombre}<br><small>${user.rol}</small><br><a href="${pageContext.request.contextPath}/logout.jsp">Salir</a></div></aside><main class="content"><header class="topbar"><span>inicio</span><b>${user.nombre}</b></header><section class="page-heading"><h1>Inicio</h1></section><section class="module-card"><h2>Hola, ${user.nombre}</h2><p>Gestiona el ciclo de vida de tu trabajo de grado.</p><p>Ideas: ${page.ideas.size()} · Proyectos: ${page.projects.size()} · Documentos: ${page.documents.size()} · PQRS: ${page.pqrs.size()}</p></section></main></body></html>