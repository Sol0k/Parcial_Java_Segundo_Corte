<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="approvedPayment">SELECT g.id FROM pago g JOIN proyecto p ON p.id=g.proyecto_id WHERE p.creado_por=? AND g.estado='APROBADO' LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="project">SELECT id,codigo,titulo,modalidad,etapa FROM proyecto WHERE creado_por=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><c:set var="phase" value="Anteproyecto"/><c:if test="${project.rowCount > 0 and project.rows[0].etapa == 2}"><c:set var="phase" value="Propuesta aprobada"/></c:if><c:if test="${project.rowCount > 0 and project.rows[0].etapa == 3}"><c:set var="phase" value="Avance 1"/></c:if><c:if test="${project.rowCount > 0 and project.rows[0].etapa == 4}"><c:set var="phase" value="Avance 2"/></c:if><c:if test="${project.rowCount > 0 and project.rows[0].etapa == 5}"><c:set var="phase" value="Informe final"/></c:if><c:if test="${project.rowCount > 0 and project.rows[0].etapa == 6}"><c:set var="phase" value="Sustentación"/></c:if><c:if test="${pageContext.request.method=='POST' and project.rowCount > 0 and approvedPayment.rowCount > 0 and param.tipo == phase}"><sql:update dataSource="${db}">INSERT INTO documento(proyecto_id,tipo,url,estado) VALUES(?,?,?,?)<sql:param value="${project.rows[0].id}"/><sql:param value="${param.tipo}"/><sql:param value="${param.url}"/><sql:param value="PENDIENTE"/></sql:update><sql:update dataSource="${db}">UPDATE proyecto SET etapa=LEAST(etapa+1,6) WHERE id=?<sql:param value="${project.rows[0].id}"/></sql:update><c:set var="ok" value="El soporte de la fase ${phase} fue enviado para revisión."/></c:if><sql:query dataSource="${db}" var="docs">SELECT d.tipo,d.url,d.estado,d.observaciones,d.creado_en FROM documento d JOIN proyecto p ON p.id=d.proyecto_id WHERE p.creado_por=? ORDER BY d.id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Fases y documentos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a class="active" href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">AVANCE DEL PROYECTO</p><h1>Fases y documentos</h1><c:choose><c:when test="${project.rowCount == 0}"><div class="card"><strong>Aún no tienes un proyecto registrado.</strong><p>Selecciona una idea aprobada desde el Banco de ideas.</p></div></c:when><c:otherwise><div class="card"><strong>${project.rows[0].codigo} · ${project.rows[0].titulo}</strong><p>Modalidad: ${project.rows[0].modalidad} · Fase actual: ${project.rows[0].etapa} de 6 (${phase})</p><c:if test="${approvedPayment.rowCount == 0}"><p><strong>Debes tener aprobado el pago de la modalidad antes de subir avances.</strong></p></c:if></div><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><c:if test="${approvedPayment.rowCount > 0 and project.rows[0].etapa <= 6}"><form method="post"><label>Fase actual<select name="tipo"><option>${phase}</option></select></label><label>URL del documento<input type="url" name="url" placeholder="https://drive.google.com/..." required></label><button>Enviar soporte a revisión</button></form></c:if><h2>Soportes enviados</h2><div class="table-wrap"><table><tr><th>Fase</th><th>Enlace</th><th>Estado</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td>${d.tipo}</td><td><a href="${d.url}" target="_blank">Abrir documento</a></td><td><span class="badge">${d.estado}</span></td><td>${d.observaciones}</td><td>${d.creado_en}</td></tr></c:forEach></table></div></c:otherwise></c:choose></section></main></body></html>