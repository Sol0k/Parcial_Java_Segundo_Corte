<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Documentos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp" class="active">Documentos</a><a href="pagos.jsp" class="">Pagos</a><a href="prorrogas.jsp" class="">Prórrogas</a><a href="pqrs.jsp" class="">PQRS</a><a href="perfil.jsp" class="">Perfil académico</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>Documentos</h1><sql:query dataSource="${db}" var="docs">SELECT d.tipo,d.url,d.estado,d.observaciones FROM documento d JOIN proyecto p ON p.id=d.proyecto_id WHERE p.creado_por=? ORDER BY d.id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><table><tr><th>Tipo</th><th>Enlace</th><th>Estado</th><th>Observaciones</th></tr><c:forEach var="d" items="${docs.rows}"><tr><td>${d.tipo}</td><td><a href="${d.url}" target="_blank">Abrir soporte</a></td><td>${d.estado}</td><td>${d.observaciones}</td></tr></c:forEach></table></section></main></body></html>