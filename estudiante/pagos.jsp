<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Pagos · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp" class="">Documentos</a><a href="pagos.jsp" class="active">Pagos</a><a href="prorrogas.jsp" class="">Prórrogas</a><a href="pqrs.jsp" class="">PQRS</a><a href="perfil.jsp" class="">Perfil académico</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>Pagos</h1><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO pago(proyecto_id,tipo,url) SELECT id,?,? FROM proyecto WHERE creado_por=?<sql:param value="${param.tipo}"/><sql:param value="${param.url}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><form method="post"><label>Tipo de pago<input name="tipo" required></label><label>URL del soporte<input type="url" name="url" required></label><button>Enviar a verificación</button></form><p>El Comité debe verificar el soporte antes de aprobarlo.</p></section></main></body></html>