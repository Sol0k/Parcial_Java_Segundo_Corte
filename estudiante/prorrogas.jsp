<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO prorroga(proyecto_id,carta_url,pago_url) SELECT id,?,? FROM proyecto WHERE creado_por=? AND (SELECT COUNT(*) FROM prorroga x WHERE x.proyecto_id=proyecto.id)<2<sql:param value="${param.carta_url}"/><sql:param value="${param.pago_url}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="rows">SELECT r.solicitado_en,r.estado,r.carta_url,r.pago_url,r.observaciones FROM prorroga r JOIN proyecto p ON p.id=r.proyecto_id WHERE p.creado_por=? ORDER BY r.solicitado_en DESC<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Prórrogas</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Prórrogas</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Solicitar prórroga de 180 días</h1><form method="post"><label>Carta de solicitud<input type="url" name="carta_url" required></label><label>Soporte de pago<input type="url" name="pago_url" required></label><button>Solicitar</button></form><h2>Solicitudes</h2><table><tr><th>Fecha</th><th>Estado</th><th>Carta</th><th>Pago</th><th>Observaciones</th></tr><c:forEach var="r" items="${rows.rows}"><tr><td>${r.solicitado_en}</td><td>${r.estado}</td><td><a href="${r.carta_url}" target="_blank">Abrir</a></td><td><a href="${r.pago_url}" target="_blank">Abrir</a></td><td>${r.observaciones}</td></tr></c:forEach></table></main></body></html>