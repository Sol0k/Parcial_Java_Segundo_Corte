<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="projects">SELECT id,codigo,titulo FROM proyecto WHERE creado_por=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Prórrogas · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a class="active" href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>Prórrogas</h1><c:if test="${pageContext.request.method=='POST' and projects.rowCount > 0}"><sql:update dataSource="${db}">INSERT INTO prorroga(proyecto_id,carta_url,pago_url) SELECT id,?,? FROM proyecto WHERE creado_por=? AND (SELECT COUNT(*) FROM prorroga x WHERE x.proyecto_id=proyecto.id)<2<sql:param value="${param.carta_url}"/><sql:param value="${param.pago_url}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="requests">SELECT r.carta_url,r.pago_url,r.estado,r.observaciones,r.solicitado_en,p.codigo FROM prorroga r JOIN proyecto p ON p.id=r.proyecto_id WHERE p.creado_por=? ORDER BY r.id DESC<sql:param value="${sessionScope.auth.id}"/></sql:query><c:choose><c:when test="${projects.rowCount == 0}"><div class="card"><strong>No tienes un proyecto registrado.</strong></div></c:when><c:otherwise><form method="post"><label>Carta de solicitud<input type="url" name="carta_url" required></label><label>Soporte de pago<input type="url" name="pago_url" required></label><button>Solicitar 180 días</button></form><h2>Mis solicitudes</h2><table><tr><th>Proyecto</th><th>Solicitud</th><th>Estado</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="r" items="${requests.rows}"><tr><td>${r.codigo}</td><td><a href="${r.carta_url}" target="_blank">Carta</a> · <a href="${r.pago_url}" target="_blank">Pago</a></td><td><span class="badge">${r.estado}</span></td><td>${r.observaciones}</td><td>${r.solicitado_en}</td></tr></c:forEach></table></c:otherwise></c:choose></section></main></body></html>