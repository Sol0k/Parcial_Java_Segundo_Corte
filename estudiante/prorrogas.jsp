<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Prórrogas · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp" class="">Documentos</a><a href="pagos.jsp" class="">Pagos</a><a href="prorrogas.jsp" class="active">Prórrogas</a><a href="pqrs.jsp" class="">PQRS</a><a href="perfil.jsp" class="">Perfil académico</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>Prórrogas</h1><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO prorroga(proyecto_id,carta_url,pago_url) SELECT id,?,? FROM proyecto WHERE creado_por=? AND (SELECT COUNT(*) FROM prorroga x WHERE x.proyecto_id=proyecto.id)<2<sql:param value="${param.carta_url}"/><sql:param value="${param.pago_url}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><form method="post"><label>Carta de solicitud<input type="url" name="carta_url" required></label><label>Soporte de pago<input type="url" name="pago_url" required></label><button>Solicitar 180 días</button></form></section></main></body></html>