<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="p">SELECT codigo,titulo,estado,etapa FROM proyecto WHERE creado_por=? ORDER BY id DESC LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Panel estudiante</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Trabajos de grado</b><span style="margin-left:auto">${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a class="active" href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a></aside><section class="content"><p style="color:#6d7d91;font-weight:700">ÁREA DEL ESTUDIANTE</p><h1>Tu proyecto, en control.</h1><div class="cards"><article>Proyectos propios<strong>${p.rowCount}</strong></article><article>Etapas del proceso<strong>6 etapas</strong></article><article>Soportes<strong>Consulta y seguimiento</strong></article></div><h2>Mis proyectos</h2><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th></tr><c:forEach var="x" items="${p.rows}"><tr><td>${x.codigo}</td><td>${x.titulo}</td><td>${x.estado}</td><td>${x.etapa}/6</td></tr></c:forEach></table></section></main></body></html>