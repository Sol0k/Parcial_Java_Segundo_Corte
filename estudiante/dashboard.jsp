<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="p">SELECT codigo,titulo,estado,etapa FROM proyecto WHERE creado_por=? ORDER BY id DESC LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Panel estudiante</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Trabajos de grado</b><span style="margin-left:auto">${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a class="active" href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a href="historial.jsp">Historial</a></aside><section class="content"><div class="card"><p class="section-kicker">ÁREA DEL ESTUDIANTE</p><h1>Hola, ${sessionScope.auth.nombre}</h1><p>Consulta tu proyecto y continúa cada etapa desde los accesos directos.</p></div><h2>Mis accesos</h2><div class="cards"><article><h3>Mi proyecto</h3><p>Equipo, director, periodo y fase actual.</p><a class="btn-link" href="proyecto.jsp">Abrir proyecto</a></article><article><h3>Banco de ideas</h3><p>Publica o selecciona una idea aprobada.</p><a class="btn-link" href="ideas.jsp">Ver ideas</a></article><article><h3>Documentos</h3><p>Sube avances según la fase lineal.</p><a class="btn-link" href="documentos.jsp">Gestionar documentos</a></article><article><h3>Pagos</h3><p>Registra y consulta tus soportes.</p><a class="btn-link" href="pagos.jsp">Ver pagos</a></article><article><h3>Prórrogas</h3><p>Solicita y consulta decisiones.</p><a class="btn-link" href="prorrogas.jsp">Ver prórrogas</a></article><article><h3>PQRS</h3><p>Envía solicitudes y revisa respuestas.</p><a class="btn-link" href="pqrs.jsp">Abrir PQRS</a></article></div><h2>Mis proyectos</h2><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th></tr><c:choose><c:when test="${p.rowCount==0}"><tr><td colspan="4"><div class="empty-state">Aún no tienes proyectos registrados.</div></td></tr></c:when><c:otherwise><c:forEach var="x" items="${p.rows}"><tr><td>${x.codigo}</td><td>${x.titulo}</td><td>${x.estado}</td><td>${x.etapa}/6</td></tr></c:forEach></c:otherwise></c:choose></table></section></main></body></html>