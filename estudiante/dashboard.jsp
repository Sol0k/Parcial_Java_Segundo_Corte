<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="p">SELECT codigo,titulo,estado,etapa FROM proyecto WHERE creado_por=? ORDER BY creado_en DESC LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Panel estudiante</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Estudiante</b><a href="../logout.jsp">Cerrar sesión</a></header><main class="content"><h1>Panel del estudiante</h1><p><a href="ideas.jsp">Banco de ideas</a> · <a href="documentos.jsp">Documentos</a> · <a href="pagos.jsp">Pagos</a> · <a href="prorrogas.jsp">Prórrogas</a> · <a href="pqrs.jsp">PQRS</a> · <a href="perfil.jsp">Perfil</a></p><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th></tr><c:forEach var="x" items="${p.rows}"><tr><td>${x.codigo}</td><td>${x.titulo}</td><td>${x.estado}</td><td>${x.etapa}/6</td></tr></c:forEach></table></main></body></html>