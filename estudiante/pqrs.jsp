<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO pqrs(usuario_id,tipo,asunto,descripcion) VALUES(?,?,?,?)<sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.tipo}"/><sql:param value="${param.asunto}"/><sql:param value="${param.descripcion}"/></sql:update><c:set var="ok" value="Tu PQRS fue enviada y quedó en estado ABIERTA."/></c:if><sql:query dataSource="${db}" var="items">SELECT id,tipo,asunto,descripcion,estado,respuesta,creado_en,fecha_respuesta FROM pqrs WHERE usuario_id=? ORDER BY id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>PQRS · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a class="active" href="pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">ATENCIÓN INSTITUCIONAL</p><h1>PQRS</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><form method="post"><label>Tipo<select name="tipo"><option>PETICIÓN</option><option>QUEJA</option><option>RECLAMO</option><option>SUGERENCIA</option></select></label><label>Asunto<input name="asunto" required></label><label>Descripción<textarea name="descripcion" required></textarea></label><button>Enviar PQRS</button></form><h2>Mis solicitudes</h2><div class="table-wrap"><table><tr><th>Fecha</th><th>Tipo</th><th>Asunto</th><th>Estado</th><th>Respuesta</th></tr><c:forEach var="p" items="${items.rows}"><tr><td>${p.creado_en}</td><td>${p.tipo}</td><td>${p.asunto}</td><td><span class="badge">${p.estado}</span></td><td><c:choose><c:when test="${not empty p.respuesta}">${p.respuesta}</c:when><c:otherwise>En revisión por el Comité</c:otherwise></c:choose></td></tr></c:forEach></table></div></section></main></body></html>