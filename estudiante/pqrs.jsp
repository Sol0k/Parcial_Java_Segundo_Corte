<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>PQRS · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp" class="">Documentos</a><a href="pagos.jsp" class="">Pagos</a><a href="prorrogas.jsp" class="">Prórrogas</a><a href="pqrs.jsp" class="active">PQRS</a><a href="perfil.jsp" class="">Perfil académico</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>PQRS</h1><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO pqrs(usuario_id,tipo,asunto,descripcion) VALUES(?,?,?,?)<sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.tipo}"/><sql:param value="${param.asunto}"/><sql:param value="${param.descripcion}"/></sql:update></c:if><form method="post"><label>Tipo<select name="tipo"><option>PETICION</option><option>QUEJA</option><option>RECLAMO</option><option>SUGERENCIA</option></select></label><label>Asunto<input name="asunto" required></label><label>Descripción<textarea name="descripcion" required></textarea></label><button>Registrar solicitud</button></form></section></main></body></html>