<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="existing">SELECT id,codigo,titulo FROM proyecto WHERE creado_por=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="ideaRow">SELECT id,titulo,modalidad,estado FROM idea WHERE id=?<sql:param value="${param.idea}"/></sql:query><sql:query dataSource="${db}" var="students">SELECT u.id,u.nombre,u.documento FROM usuario u WHERE u.rol='ESTUDIANTE' AND u.activo=1 AND u.id<>? ORDER BY u.nombre<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="teachers">SELECT u.id,u.nombre,d.tipo FROM docente d JOIN usuario u ON u.id=d.usuario_id JOIN inscripcion_docente_periodo ip ON ip.docente_id=d.usuario_id JOIN calendario ca ON ca.id=ip.periodo_id AND ca.activo=1 WHERE u.activo=1 AND ip.puede_dirigir=1 ORDER BY u.nombre</sql:query><sql:query dataSource="${db}" var="companies">SELECT clave,valor FROM parametro WHERE clave LIKE 'empresa_%' ORDER BY valor</sql:query><c:if test="${pageContext.request.method=='POST' and existing.rowCount == 0 and ideaRow.rowCount > 0 and ideaRow.rows[0].estado == 'APROBADA' and (ideaRow.rows[0].modalidad ne 'Práctica' or not empty param.empresa_nit)}"><sql:update dataSource="${db}">INSERT INTO proyecto(codigo,titulo,modalidad,estado,etapa,idea_id,creado_por,empresa_nit) VALUES(?,?,?,?,?,?,?,?)<sql:param value="${param.codigo}"/><sql:param value="${param.titulo}"/><sql:param value="${param.modalidad}"/><sql:param value="PROPUESTA"/><sql:param value="1"/><sql:param value="${param.idea_id}"/><sql:param value="${sessionScope.auth.id}"/><sql:param value="${param.empresa_nit}"/></sql:update><sql:query dataSource="${db}" var="newProject">SELECT id FROM proyecto WHERE codigo=?<sql:param value="${param.codigo}"/></sql:query><c:forEach var="np" items="${newProject.rows}"><sql:update dataSource="${db}">INSERT INTO integrante(proyecto_id,usuario_id) VALUES(?,?)<sql:param value="${np.id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update><c:if test="${not empty param.integrante2}"><sql:update dataSource="${db}">INSERT INTO integrante(proyecto_id,usuario_id) VALUES(?,?)<sql:param value="${np.id}"/><sql:param value="${param.integrante2}"/></sql:update></c:if><c:if test="${not empty param.integrante3}"><sql:update dataSource="${db}">INSERT INTO integrante(proyecto_id,usuario_id) VALUES(?,?)<sql:param value="${np.id}"/><sql:param value="${param.integrante3}"/></sql:update></c:if><c:if test="${not empty param.docente_id}"><sql:update dataSource="${db}">INSERT INTO asignacion(proyecto_id,docente_id,tipo,estado) SELECT ?,?,?,? WHERE NOT EXISTS (SELECT 1 FROM asignacion ax WHERE ax.proyecto_id=? AND ax.docente_id=? AND ax.tipo='EVALUADOR')<sql:param value="${np.id}"/><sql:param value="${param.docente_id}"/><sql:param value="DIRECTOR"/><sql:param value="PROPUESTA"/><sql:param value="${np.id}"/><sql:param value="${param.docente_id}"/></sql:update></c:if></c:forEach><c:set var="ok" value="La propuesta fue enviada con sus integrantes y docente sugerido."/></c:if><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Configurar propuesta · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">CONFIGURACIÓN DEL EQUIPO</p><h1>Proponer esta idea</h1><c:if test="${existing.rowCount > 0}"><div class="card"><strong>Ya tienes un proyecto registrado: ${existing.rows[0].codigo}.</strong><p>Solo puedes realizar un proyecto de grado.</p><a class="btn-link" href="dashboard.jsp">Ver mi proyecto</a></div></c:if><c:if test="${ideaRow.rowCount == 0 or ideaRow.rows[0].estado ne 'APROBADA'}"><div class="card"><strong>Esta idea no está disponible.</strong><p>Solo puedes tomar ideas aprobadas por el Comité.</p></div></c:if><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><c:if test="${existing.rowCount == 0 and ideaRow.rowCount > 0 and ideaRow.rows[0].estado == 'APROBADA'}"><form method="post"><input type="hidden" name="idea_id" value="${param.idea}"><label>Código del proyecto<input name="codigo" pattern="[A-Z]{3}-[0-9]{4}\.[0-9]-[0-9]{2}" placeholder="SIS-2026.1-01" required></label><label>Título<input name="titulo" value="${ideaRow.rows[0].titulo}" required></label><label>Modalidad<select name="modalidad"><option ${ideaRow.rows[0].modalidad=='Proyecto'?'selected':''}>Proyecto</option><option ${ideaRow.rows[0].modalidad=='Monografía'?'selected':''}>Monografía</option><option>Práctica</option><option>Seminario</option><option>Desarrollo Tecnológico</option></select></label><h2>Integrantes</h2><p>El estudiante actual ya es integrante. Puedes agregar hasta dos personas más.</p><label>Integrante 2<select name="integrante2"><option value="">Sin integrante</option><c:forEach var="s" items="${students.rows}"><option value="${s.id}">${s.nombre} · ${s.documento}</option></c:forEach></select></label><label>Integrante 3<select name="integrante3"><option value="">Sin integrante</option><c:forEach var="s" items="${students.rows}"><option value="${s.id}">${s.nombre} · ${s.documento}</option></c:forEach></select></label><h2>Empresa de práctica</h2><p>Para la modalidad Práctica debes seleccionar una empresa registrada por el Comité.</p><label>Empresa<select name="empresa_nit"><option value="">Sin empresa</option><c:forEach var="e" items="${companies.rows}"><option value="${e.clave.substring(8)}">${e.clave.substring(8)} · ${e.valor}</option></c:forEach></select></label><h2>Docente a cargo</h2><p>Puedes sugerir un docente; la asignación queda pendiente de validación.</p><label>Docente sugerido<select name="docente_id"><option value="">Sin docente por ahora</option><c:forEach var="t" items="${teachers.rows}"><option value="${t.id}">${t.nombre} · ${t.tipo}</option></c:forEach></select></label><button>Enviar propuesta</button></form></c:if></section></main></body></html>