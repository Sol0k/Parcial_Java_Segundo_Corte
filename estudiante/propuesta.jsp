<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO proyecto(codigo,titulo,modalidad,estado,etapa,creado_por) VALUES(?,?,?,?,?,?)<sql:param value="${param.codigo}"/><sql:param value="${param.titulo}"/><sql:param value="${param.modalidad}"/><sql:param value="PROPUESTA"/><sql:param value="1"/><sql:param value="${sessionScope.auth.id}"/></sql:update><c:set var="ok" value="Propuesta registrada correctamente."/></c:if><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Propuesta · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="dashboard.jsp">Resumen</a><a class="active" href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a href="perfil.jsp">Perfil académico</a></aside><section class="content"><p class="section-kicker">NUEVA PROPUESTA</p><h1>Registrar propuesta</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><form method="post"><label>Código del proyecto<input name="codigo" pattern="[A-Z]{3}-[0-9]{4}\.[0-9]-[0-9]{2}" placeholder="SIS-2026.1-01" required></label><label>Título<input name="titulo" required></label><label>Modalidad<select name="modalidad"><option>Proyecto</option><option>Monografía</option><option>Práctica</option></select></label><button>Enviar propuesta</button></form></section></main></body></html>