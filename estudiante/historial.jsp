<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="rows">SELECT entidad,entidad_id,accion,observaciones,creado_en FROM historial WHERE usuario_id=? ORDER BY creado_en DESC LIMIT 100<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Historial · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Historial</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="equipo.jsp">Equipo y director</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a class="active" href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">TRAZABILIDAD</p><h1>Historial</h1><table><tr><th>Entidad</th><th>Acción</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="x" items="${rows.rows}"><tr><td>${x.entidad} #${x.entidad_id}</td><td>${x.accion}</td><td>${x.observaciones}</td><td>${x.creado_en}</td></tr></c:forEach></table></section></main></body></html>