<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="project">SELECT p.id,p.codigo FROM proyecto p JOIN integrante i ON i.proyecto_id=p.id WHERE i.usuario_id=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="students">SELECT u.id,u.nombre,u.documento FROM usuario u JOIN estudiante e ON e.usuario_id=u.id WHERE u.rol='ESTUDIANTE' AND u.activo=1 AND u.id<>? ORDER BY u.nombre<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="teachers">SELECT u.id,u.nombre,d.tipo FROM usuario u JOIN docente d ON d.usuario_id=u.id WHERE u.activo=1 ORDER BY u.nombre</sql:query><c:if test="${pageContext.request.method=='POST' and project.rowCount>0}"><c:if test="${param.accion=='DIRECTOR'}"><sql:update dataSource="${db}">INSERT INTO asignacion(proyecto_id,docente_id,tipo,estado) VALUES(?,?,?,?)<sql:param value="${project.rows[0].id}"/><sql:param value="${param.docente_id}"/><sql:param value="DIRECTOR"/><sql:param value="PROPUESTA"/></sql:update></c:if><c:if test="${param.accion=='INTEGRANTE'}"><sql:update dataSource="${db}">INSERT INTO historial(usuario_id,entidad,entidad_id,accion,observaciones) VALUES(?,?,?,?,?)<sql:param value="${sessionScope.auth.id}"/><sql:param value="${project.rows[0].id}"/><sql:param value="${project.rows[0].id}"/><sql:param value="SOLICITUD_INTEGRANTE"/><sql:param value="${param.integrante_id}"/></sql:update></c:if><c:set var="ok" value="La propuesta fue enviada para revisión."/></c:if><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Equipo · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a class="active" href="equipo.jsp">Equipo y director</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a></aside><section class="content"><h1>Equipo y director</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><c:choose><c:when test="${project.rowCount==0}"><div class="empty-state"><strong>No tienes proyecto registrado.</strong><p>Selecciona primero una idea aprobada.</p></div></c:when><c:otherwise><div class="card"><h2>Proponer director</h2><form method="post"><input type="hidden" name="accion" value="DIRECTOR"><label>Docente<select name="docente_id" required><c:forEach var="t" items="${teachers.rows}"><option value="${t.id}">${t.nombre} · ${t.tipo}</option></c:forEach></select></label><button>Proponer director</button></form></div><div class="card"><h2>Solicitar compañero</h2><p>La solicitud será revisada por el Comité antes de agregar el integrante.</p><form method="post"><input type="hidden" name="accion" value="INTEGRANTE"><label>Buscar por nombre<select name="integrante_id" required><c:forEach var="s" items="${students.rows}"><option value="${s.id}">${s.nombre} · ${s.documento}</option></c:forEach></select></label><button>Enviar solicitud</button></form></div></c:otherwise></c:choose></section></main></body></html>