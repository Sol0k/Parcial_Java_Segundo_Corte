<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="p">SELECT p.id,p.codigo,p.titulo,p.modalidad,p.etapa,p.estado,p.empresa_nit,e.programa,e.nivel,(SELECT nombre FROM calendario WHERE activo=1 ORDER BY apertura DESC LIMIT 1) AS periodo,(SELECT apertura FROM calendario WHERE activo=1 ORDER BY apertura DESC LIMIT 1) AS apertura,(SELECT cierre FROM calendario WHERE activo=1 ORDER BY apertura DESC LIMIT 1) AS plazo,(SELECT valor FROM parametro WHERE clave='max_prorrogas') AS max_prorrogas,(SELECT valor FROM parametro WHERE clave='dias_prorroga') AS dias_prorroga FROM proyecto p JOIN integrante member_ref ON member_ref.proyecto_id=p.id JOIN estudiante e ON e.usuario_id=member_ref.usuario_id WHERE member_ref.usuario_id=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="team">SELECT u.id,u.nombre,u.documento FROM integrante i JOIN usuario u ON u.id=i.usuario_id WHERE i.proyecto_id=? ORDER BY u.nombre<sql:param value="${p.rows[0].id}"/></sql:query><sql:query dataSource="${db}" var="students">SELECT u.id,u.nombre,u.documento FROM usuario u JOIN estudiante e ON e.usuario_id=u.id WHERE u.rol='ESTUDIANTE' AND u.activo=1 AND u.id NOT IN (SELECT usuario_id FROM integrante WHERE proyecto_id=?) ORDER BY u.nombre<sql:param value="${p.rows[0].id}"/></sql:query><sql:query dataSource="${db}" var="teachers">SELECT u.id,u.nombre,d.tipo FROM usuario u JOIN docente d ON d.usuario_id=u.id JOIN inscripcion_docente_periodo ip ON ip.docente_id=u.id JOIN calendario ca ON ca.id=ip.periodo_id AND ca.activo=1 WHERE u.activo=1 AND ip.puede_dirigir=1 AND NOT EXISTS (SELECT 1 FROM asignacion ax WHERE ax.proyecto_id=? AND ax.docente_id=u.id AND ax.tipo='EVALUADOR') ORDER BY u.nombre<sql:param value="${p.rows[0].id}"/></sql:query><c:if test="${pageContext.request.method=='POST' and p.rowCount>0}"><c:if test="${param.accion=='INTEGRANTE' and team.rowCount < 3}"><sql:update dataSource="${db}">INSERT IGNORE INTO integrante(proyecto_id,usuario_id) VALUES(?,?)<sql:param value="${p.rows[0].id}"/><sql:param value="${param.integrante_id}"/></sql:update><c:set var="ok" value="El compañero fue agregado al equipo."/></c:if><c:if test="${param.accion=='DIRECTOR'}"><sql:update dataSource="${db}">INSERT INTO asignacion(proyecto_id,docente_id,tipo,estado) SELECT ?,?,?,? WHERE NOT EXISTS (SELECT 1 FROM asignacion ax WHERE ax.proyecto_id=? AND ax.docente_id=? AND ax.tipo='EVALUADOR')<sql:param value="${p.rows[0].id}"/><sql:param value="${param.docente_id}"/><sql:param value="DIRECTOR"/><sql:param value="PROPUESTA"/><sql:param value="${p.rows[0].id}"/><sql:param value="${param.docente_id}"/></sql:update><c:set var="ok" value="La propuesta de director fue enviada."/></c:if></c:if><sql:query dataSource="${db}" var="staff">SELECT u.nombre,a.tipo,a.estado FROM asignacion a JOIN usuario u ON u.id=a.docente_id WHERE a.proyecto_id=? AND a.estado IN ('ACTIVA','PROPUESTA')<sql:param value="${p.rows[0].id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Mi proyecto · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a class="active" href="proyecto.jsp">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">SEGUIMIENTO ACADÉMICO</p><h1>Mi proyecto</h1><c:choose><c:when test="${p.rowCount==0}"><div class="empty-state"><strong>Aún no tienes proyecto.</strong><p>Selecciona una idea aprobada desde el Banco de ideas.</p></div></c:when><c:otherwise><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><div class="card"><h2>${p.rows[0].codigo} · ${p.rows[0].titulo}</h2><p>Programa: ${p.rows[0].programa}</p><p>Modalidad: ${p.rows[0].modalidad}</p><p>Empresa: ${p.rows[0].empresa_nit}</p><p>Nivel: ${p.rows[0].nivel}</p><p>Personas permitidas: máximo 3 · Equipo actual: ${team.rowCount}</p><p>Fase actual: ${p.rows[0].etapa} de 6</p><p>Periodo: ${p.rows[0].periodo}</p><p>Inscripciones: ${p.rows[0].apertura} · Cierre: ${p.rows[0].plazo}</p><p>Prórroga: hasta ${p.rows[0].max_prorrogas} solicitudes de ${p.rows[0].dias_prorroga} días</p><p>Estado: <span class="badge">${p.rows[0].estado}</span></p></div><div class="card"><h2>Equipo</h2><table><tr><th>Nombre</th><th>Documento</th></tr><c:forEach var="m" items="${team.rows}"><tr><td>${m.nombre}</td><td>${m.documento}</td></tr></c:forEach></table><c:if test="${team.rowCount < 3}"><form method="post"><input type="hidden" name="accion" value="INTEGRANTE"><label>Agregar compañero<select name="integrante_id" required><c:forEach var="s" items="${students.rows}"><option value="${s.id}">${s.nombre} · ${s.documento}</option></c:forEach></select></label><button>Agregar al equipo</button></form></c:if><c:if test="${team.rowCount >= 3}"><p class="empty-state">El equipo alcanzó el máximo permitido.</p></c:if></div><div class="card"><h2>Director y evaluador</h2><table><tr><th>Docente</th><th>Rol</th><th>Estado</th></tr><c:forEach var="s" items="${staff.rows}"><tr><td>${s.nombre}</td><td>${s.tipo}</td><td>${s.estado}</td></tr></c:forEach></table><form method="post"><input type="hidden" name="accion" value="DIRECTOR"><label>Proponer director<select name="docente_id" required><c:forEach var="t" items="${teachers.rows}"><option value="${t.id}">${t.nombre} · ${t.tipo}</option></c:forEach></select></label><button>Proponer director</button></form></div></c:otherwise></c:choose></section></main></body></html>