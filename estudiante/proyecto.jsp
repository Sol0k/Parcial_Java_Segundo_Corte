<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="p">SELECT p.id,p.codigo,p.titulo,p.modalidad,p.etapa,p.estado,e.programa,idea_ref.nivel,(SELECT MAX(cierre) FROM calendario WHERE activo=1) AS plazo FROM proyecto p LEFT JOIN idea idea_ref ON idea_ref.id=p.idea_id JOIN integrante member_ref ON member_ref.proyecto_id=p.id JOIN estudiante e ON e.usuario_id=member_ref.usuario_id WHERE member_ref.usuario_id=? LIMIT 1<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="team">SELECT u.nombre,u.documento FROM integrante i JOIN usuario u ON u.id=i.usuario_id JOIN proyecto p ON p.id=i.proyecto_id WHERE i.proyecto_id=?<sql:param value="${p.rows[0].id}"/></sql:query><sql:query dataSource="${db}" var="staff">SELECT u.nombre,a.tipo FROM asignacion a JOIN usuario u ON u.id=a.docente_id WHERE a.proyecto_id=? AND a.estado IN ('ACTIVA','PROPUESTA')<sql:param value="${p.rows[0].id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Mi proyecto · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp" class="active">Proyecto</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a></aside><section class="content"><p class="section-kicker">SEGUIMIENTO ACADÉMICO</p><h1>Mi proyecto</h1><c:choose><c:when test="${p.rowCount==0}"><div class="card"><strong>Aún no tienes proyecto.</strong></div></c:when><c:otherwise><div class="card"><h2>${p.rows[0].codigo} · ${p.rows[0].titulo}</h2><p>Programa: ${p.rows[0].programa}</p><p>Modalidad: ${p.rows[0].modalidad}</p><p>Nivel: ${p.rows[0].nivel}</p><p>Personas permitidas: máximo 3</p><p>Fase actual: ${p.rows[0].etapa} de 6</p><p>Plazo vigente: ${p.rows[0].plazo}</p><p>Estado: <span class="badge">${p.rows[0].estado}</span></p></div><div class="card"><h2>Equipo</h2><table><tr><th>Nombre</th><th>Documento</th></tr><c:forEach var="m" items="${team.rows}"><tr><td>${m.nombre}</td><td>${m.documento}</td></tr></c:forEach></table></div><div class="card"><h2>Director y evaluador</h2><table><tr><th>Docente</th><th>Rol</th></tr><c:forEach var="s" items="${staff.rows}"><tr><td>${s.nombre}</td><td>${s.tipo}</td></tr></c:forEach></table></div></c:otherwise></c:choose></section></main></body></html>