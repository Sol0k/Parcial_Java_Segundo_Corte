<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO idea(titulo,descripcion,nivel,modalidad,estado,creado_por) VALUES(?,?,?,?,?,?)<sql:param value="${param.titulo}"/><sql:param value="${param.descripcion}"/><sql:param value="${param.nivel}"/><sql:param value="${param.modalidad}"/><sql:param value="PENDIENTE"/><sql:param value="${sessionScope.auth.id}"/></sql:update><c:set var="ok" value="Tu idea fue publicada y enviada al Comité para revisión."/></c:if><sql:query dataSource="${db}" var="ideas">SELECT i.id,i.titulo,i.descripcion,i.nivel,i.modalidad,i.estado,u.nombre,u.rol FROM idea i JOIN usuario u ON u.id=i.creado_por WHERE i.estado='APROBADA' ORDER BY i.id DESC LIMIT 100</sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Banco de ideas · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><c:if test="${sessionScope.auth.rol eq 'ADMINISTRADOR'}"><a class="back-link" href="../dashboard.jsp">← Panel principal</a></c:if><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="proyecto.jsp">Proyecto</a><a href="equipo.jsp">Equipo y director</a><a class="active" href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp">Documentos</a><a href="pagos.jsp">Pagos</a><a href="prorrogas.jsp">Prórrogas</a><a href="pqrs.jsp">PQRS</a><a href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">EXPLORACIÓN ACADÉMICA</p><h1>Banco de ideas</h1><c:if test="${not empty ok}"><div class="card"><strong>${ok}</strong></div></c:if><h2>Publicar una idea</h2><form method="post"><label>Título<input name="titulo" required></label><label>Descripción<textarea name="descripcion" required></textarea></label><label>Nivel<select name="nivel"><option>Profesional</option><option>Tecnológico</option></select></label><label>Modalidad<select name="modalidad"><option>Proyecto</option><option>Monografía</option><option>Práctica</option><option>Seminario</option><option>Desarrollo Tecnológico</option></select></label><button>Enviar idea al Comité</button></form><h2>Ideas aprobadas disponibles</h2><div class="card"><p>Solo se muestran ideas aprobadas por el Comité. Cada estudiante puede registrar un único proyecto de grado, individual o con hasta tres integrantes.</p></div><table><tr><th>Título</th><th>Descripción</th><th>Nivel</th><th>Modalidad</th><th>Estado</th><th>Propuesta por</th><th>Acción</th></tr><c:forEach var="i" items="${ideas.rows}"><tr><td><strong>${i.titulo}</strong></td><td>${i.descripcion}</td><td>${i.nivel}</td><td>${i.modalidad}</td><td>${i.estado}</td><td>${i.nombre} · ${i.rol}</td><td><c:if test="${i.estado == 'PENDIENTE' or i.estado == 'APROBADA'}"><a class="btn-link" href="propuesta.jsp?idea=${i.id}">Tomar idea</a></c:if></td></tr></c:forEach></table></section></main></body></html>