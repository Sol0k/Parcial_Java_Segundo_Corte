<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="ideas">SELECT id,titulo,descripcion,nivel,modalidad,estado FROM idea WHERE estado='PENDIENTE' AND (titulo LIKE ? OR descripcion LIKE ?) ORDER BY id DESC LIMIT 50<sql:param value="%${empty param.q ? '' : param.q}%"/><sql:param value="%${empty param.q ? '' : param.q}%"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Banco de ideas</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Banco de ideas</b><a href="dashboard.jsp">Panel</a><a href="../logout.jsp">Cerrar sesión</a></header><main class="content"><h1>Banco de ideas</h1><form method="get"><label>Buscar por título o descripción<input name="q" value="${param.q}" placeholder="Ej. inteligencia artificial"></label><button>Buscar ideas</button></form><div class="cards" style="margin-top:24px"><c:forEach var="i" items="${ideas.rows}"><article><small>${i.nivel} · ${i.modalidad}</small><h2>${i.titulo}</h2><p>${i.descripcion}</p><a href="propuesta.jsp?idea=${i.id}">Proponer esta idea</a></article></c:forEach></div></main></body></html>