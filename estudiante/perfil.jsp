<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'ESTUDIANTE' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Perfil · UTS</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Trabajos de grado</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">MI ESPACIO</div><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="ideas.jsp">Banco de ideas</a><a href="documentos.jsp" class="">Documentos</a><a href="pagos.jsp" class="">Pagos</a><a href="prorrogas.jsp" class="">Prórrogas</a><a href="pqrs.jsp" class="">PQRS</a><a href="perfil.jsp" class="active">Perfil académico</a></aside><section class="content"><p class="section-kicker">MI ESPACIO</p><h1>Perfil</h1><sql:query dataSource="${db}" var="profile">SELECT u.documento,u.nombre,u.correo,e.programa,e.nivel,e.creditos_aprobados FROM usuario u JOIN estudiante e ON e.usuario_id=u.id WHERE u.id=?<sql:param value="${sessionScope.auth.id}"/></sql:query><c:forEach var="p" items="${profile.rows}"><div class="card profile-card"><p><b>Documento</b><br>${p.documento}</p><p><b>Nombre</b><br>${p.nombre}</p><p><b>Correo</b><br>${p.correo}</p><p><b>Programa</b><br>${p.programa}</p><p><b>Nivel</b><br>${p.nivel}</p><p><b>Créditos aprobados</b><br>${p.creditos_aprobados}%</p></div></c:forEach></section></main></body></html>