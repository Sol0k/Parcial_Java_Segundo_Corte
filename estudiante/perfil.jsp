<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="profile">SELECT u.documento,u.nombre,u.correo,e.programa,e.nivel,e.creditos_aprobados FROM usuario u JOIN estudiante e ON e.usuario_id=u.id WHERE u.id=?<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Perfil académico</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Perfil</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Datos académicos</h1><c:forEach var="p" items="${profile.rows}"><div class="card"><p><b>Documento:</b> ${p.documento}</p><p><b>Nombre:</b> ${p.nombre}</p><p><b>Correo:</b> ${p.correo}</p><p><b>Programa:</b> ${p.programa}</p><p><b>Nivel:</b> ${p.nivel}</p><p><b>Créditos aprobados:</b> ${p.creditos_aprobados}%</p></div></c:forEach></main></body></html>