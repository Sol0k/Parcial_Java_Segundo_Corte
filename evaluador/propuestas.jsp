<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><sql:setDataSource var="db" dataSource="jdbc/uts"/><sql:query dataSource="${db}" var="rows">SELECT p.codigo,p.titulo,p.estado,p.etapa FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo LIKE 'EVALUADOR%' AND a.estado='ACTIVA' ORDER BY p.creado_en DESC LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Evaluaciones</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Evaluación</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Propuestas asignadas</h1><table><tr><th>Código</th><th>Título</th><th>Estado</th><th>Etapa</th></tr><c:forEach var="p" items="${rows.rows}"><tr><td>${p.codigo}</td><td>${p.titulo}</td><td>${p.estado}</td><td>${p.etapa}/6</td></tr></c:forEach></table></main></body></html>