<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'EVALUADOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="${'jdbc/uts'}"/><sql:query dataSource="${db}" var="rows">SELECT e.tipo,e.concepto,e.observaciones,e.creado_en,p.codigo FROM evaluacion e JOIN proyecto p ON p.id=e.proyecto_id WHERE e.evaluador_id=? ORDER BY e.id DESC LIMIT 100<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Historial de evaluaciones</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Evaluación</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">EVALUACIÓN</div><a href="dashboard.jsp">Resumen</a><a href="propuestas.jsp">Propuestas</a><a href="evaluaciones.jsp">Registrar evaluación</a><a class="active" href="historial.jsp">Historial</a></aside><section class="content"><p class="section-kicker">TRAZABILIDAD</p><h1>Historial de evaluaciones</h1><table><tr><th>Proyecto</th><th>Tipo</th><th>Concepto</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="x" items="${rows.rows}"><tr><td>${x.codigo}</td><td>${x.tipo}</td><td>${x.concepto}</td><td>${x.observaciones}</td><td>${x.creado_en}</td></tr></c:forEach></table></section></main></body></html>