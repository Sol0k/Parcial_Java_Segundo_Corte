<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'EVALUADOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST' and (param.tipo=='PROPUESTA' or param.tipo=='INFORME_FINAL')}"><sql:update dataSource="${db}">INSERT INTO evaluacion(proyecto_id,evaluador_id,tipo,concepto,observaciones) SELECT a.proyecto_id,a.docente_id,?,?,? FROM asignacion a WHERE a.proyecto_id=? AND a.docente_id=? AND a.tipo LIKE 'EVALUADOR%' AND a.estado='ACTIVA'<sql:param value="${param.tipo}"/><sql:param value="${param.concepto}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="history">SELECT e.tipo,e.concepto,e.observaciones,e.creado_en,p.codigo FROM evaluacion e JOIN proyecto p ON p.id=e.proyecto_id WHERE e.evaluador_id=? ORDER BY e.id DESC LIMIT 50<sql:param value="${sessionScope.auth.id}"/></sql:query><sql:query dataSource="${db}" var="projects">SELECT DISTINCT p.id,p.codigo,p.titulo,p.estado,p.etapa FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo LIKE 'EVALUADOR%' AND a.estado='ACTIVA' AND p.etapa IN (2,6) LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Evaluaciones</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Evaluaciones</b><span>${sessionScope.auth.nombre}</span><a href="../logout.jsp">Cerrar sesión</a></header><main class="shell"><aside><div class="nav-title">EVALUACIÓN</div><a href="../notificaciones.jsp">Notificaciones</a><a href="../perfil.jsp">Cuenta personal</a><a href="dashboard.jsp">Resumen</a><a href="propuestas.jsp">Propuestas</a><a class="active" href="evaluaciones.jsp">Registrar evaluación</a><a href="historial.jsp">Historial</a></aside><section class="content"><h1>Registrar evaluación</h1><div class="card"><strong>Flujo de evaluación lineal</strong><p>El evaluador solo puede registrar conceptos en las fases habilitadas: fase 2, evaluación de propuesta, y fase 6, evaluación final. Las fases intermedias no requieren evaluación del evaluador.</p></div><c:forEach var="p" items="${projects.rows}"><c:set var="evaluationType" value="PROPUESTA"/><c:if test="${p.etapa == 6}"><c:set var="evaluationType" value="INFORME_FINAL"/></c:if><form method="post" class="card"><input type="hidden" name="proyecto_id" value="${p.id}"><h2>${p.codigo} · ${p.titulo}</h2><input type="hidden" name="tipo" value="${evaluationType}"><p>Evaluación correspondiente: <strong>${evaluationType}</strong> · Fase ${p.etapa}/6</p><select name="concepto"><option>APROBADO</option><option>APROBADO_CON_CORRECCIONES</option><option>NO_APROBADO</option></select><textarea name="observaciones" placeholder="Observaciones" required></textarea><button>Guardar concepto</button></form></c:forEach><h2>Evaluaciones registradas</h2><table><tr><th>Proyecto</th><th>Tipo</th><th>Concepto</th><th>Observaciones</th><th>Fecha</th></tr><c:forEach var="e" items="${history.rows}"><tr><td>${e.codigo}</td><td>${e.tipo}</td><td><span class="badge">${e.concepto}</span></td><td>${e.observaciones}</td><td>${e.creado_en}</td></tr></c:forEach></table></section></main></body></html>