<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><jsp:include page="/includes/guard.jspf"/><c:if test="${sessionScope.auth.rol ne 'EVALUADOR' and sessionScope.auth.rol ne 'ADMINISTRADOR'}"><c:redirect url="../login.jsp"/></c:if><sql:setDataSource var="db" dataSource="jdbc/uts"/><c:if test="${pageContext.request.method=='POST'}"><sql:update dataSource="${db}">INSERT INTO evaluacion(proyecto_id,evaluador_id,tipo,concepto,observaciones) SELECT a.proyecto_id,a.docente_id,?,?,? FROM asignacion a WHERE a.proyecto_id=? AND a.docente_id=? AND a.tipo LIKE 'EVALUADOR%' AND a.estado='ACTIVA'<sql:param value="${param.tipo}"/><sql:param value="${param.concepto}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.proyecto_id}"/><sql:param value="${sessionScope.auth.id}"/></sql:update></c:if><sql:query dataSource="${db}" var="projects">SELECT DISTINCT p.id,p.codigo,p.titulo,p.estado FROM proyecto p JOIN asignacion a ON a.proyecto_id=p.id WHERE a.docente_id=? AND a.tipo LIKE 'EVALUADOR%' AND a.estado='ACTIVA' LIMIT 20<sql:param value="${sessionScope.auth.id}"/></sql:query><!doctype html><html lang="es"><head><meta charset="UTF-8"><title>Evaluaciones</title><link rel="stylesheet" href="../assets/css/estilos.css"></head><body><header><b>UTS · Evaluaciones</b><a href="../dashboard.jsp">Panel</a></header><main class="content"><h1>Registrar evaluación</h1><c:forEach var="p" items="${projects.rows}"><form method="post" class="card"><input type="hidden" name="proyecto_id" value="${p.id}"><h2>${p.codigo} · ${p.titulo}</h2><select name="tipo"><option>PROPUESTA</option><option>INFORME_FINAL</option></select><select name="concepto"><option>APROBADO</option><option>APROBADO_CON_CORRECCIONES</option><option>NO_APROBADO</option></select><textarea name="observaciones" placeholder="Observaciones" required></textarea><button>Guardar concepto</button></form></c:forEach></main></body></html>